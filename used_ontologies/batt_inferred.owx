        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Newton</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#Newton</IRI>
        <Literal xml:lang="en">SI unit for force.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#Newton</IRI>
        <Literal xml:lang="en">The &quot;Newton&quot; is the SI unit of force. A force of one newton will accelerate a mass of one kilogram at the rate of one meter per second per second. The newton is named for Isaac Newton (1642-1727), the British mathematician, physicist, and natural philosopher. He was the first person to understand clearly the relationship between force (F), mass (m), and acceleration (a) expressed by the formula F = m·a.

-- QUDT</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
