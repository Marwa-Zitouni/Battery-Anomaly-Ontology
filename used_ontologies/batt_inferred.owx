        <Literal xml:lang="en">AlkalineSolution</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_615cff2a_be95_4e65_9471_98db23f4c878</IRI>
        <Literal xml:lang="en">AlkalineElectrolyte</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_61740c42_d332_492c_8b37_90a187c7f6d9</IRI>
        <Literal>https://www.wikidata.org/wiki/Q4016325</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_61740c42_d332_492c_8b37_90a187c7f6d9</IRI>
        <Literal xml:lang="en">stripping voltammetry in which material accumulated at the working electrode is electrochemically reduced in the stripping step</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_61740c42_d332_492c_8b37_90a187c7f6d9</IRI>
        <Literal xml:lang="en">https://doi.org/10.1515/pac-2018-0109</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_61740c42_d332_492c_8b37_90a187c7f6d9</IRI>
        <Literal xml:lang="en">A peak-shaped cathodic stripping voltammogram is obtained. Peak current depends on time of accumulation, mass transport of analyte (stirring), scan rate and mode (linear or pulse), and analyte concentration in solution.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_61740c42_d332_492c_8b37_90a187c7f6d9</IRI>
