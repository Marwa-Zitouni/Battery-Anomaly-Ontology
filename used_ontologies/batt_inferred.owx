        <Literal xml:lang="en">electrochemical reaction involving the transfer of electrons between electrolyte and electrode</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
