    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d"/>
            <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Variable_(mathematics)</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_1eed0732_e3f1_4b2c_a9c4_b4e75eeb5895</IRI>
        <Literal xml:lang="en">A variable is a symbolic object that stands for any other mathematical object, such as  number, a vector, a matrix, a function, the argument of a function, a set, an element of a set.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_b432d2d5_25f4_4165_99c5_5935a7763c1a"/>
        <IRI>http://emmo.info/emmo#EMMO_1eed0732_e3f1_4b2c_a9c4_b4e75eeb5895</IRI>
        <Literal xml:lang="en">x
k</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_705f27ae_954c_4f13_98aa_18473fc52b25"/>
            <Literal xml:lang="en">Fom Latin variabilis (&quot;changeable&quot;).</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_1eed0732_e3f1_4b2c_a9c4_b4e75eeb5895</IRI>
        <Literal xml:lang="en">Variable</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_1efe8b96_e006_4a33_bc9a_421406cbb9f0</IRI>
        <Literal xml:lang="en">The superclass of entities which are defined by requiring the existence of some parts (at least one) of specifically given types, where the specified types are different with respect to the type of the whole.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_1efe8b96_e006_4a33_bc9a_421406cbb9f0</IRI>
        <Literal xml:lang="en">A whole is always defined using a criterion expressed through the classical transitive parthood relation.
This class is expected to host the definition of world objects as they appear in its wholeness, dependently on some of their parts and independently on the surroundings.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/emmo#EMMO_1efe8b96_e006_4a33_bc9a_421406cbb9f0</IRI>
        <Literal xml:lang="en">A whole is categorized as fundamental (or maximal) or redundant (non-maximal).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_705f27ae_954c_4f13_98aa_18473fc52b25"/>
            <Literal xml:lang="en">From Middle English hole (“healthy, unhurt, whole”).</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_1efe8b96_e006_4a33_bc9a_421406cbb9f0</IRI>
        <Literal xml:lang="en">Whole</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
