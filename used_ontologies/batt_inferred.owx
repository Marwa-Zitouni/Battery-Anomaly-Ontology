        <IRI>http://emmo.info/electrochemistry#electrochemistry_e1fd84eb_acdb_4b2c_b90c_e899d552a3ee</IRI>
        <Literal>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=482-05-45</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://purl.org/dc/terms/source"/>
            <Literal>International Electrotechnical Commission (IEC), IEC 60050 - International Electrotechnical Vocabulary, retrieved from: https://www.electropedia.org</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e1fd84eb_acdb_4b2c_b90c_e899d552a3ee</IRI>
        <Literal xml:lang="en">[an indicator of the] electric current at which a secondary cell or battery is charged</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e1fd84eb_acdb_4b2c_b90c_e899d552a3ee</IRI>
        <Literal xml:lang="en">in practice, the term CRate is often used to mean DRate</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://purl.org/dc/terms/source"/>
            <Literal>International Electrotechnical Commission (IEC), IEC 60050 - International Electrotechnical Vocabulary, retrieved from: https://www.electropedia.org</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e1fd84eb_acdb_4b2c_b90c_e899d552a3ee</IRI>
        <Literal xml:lang="en">the charge rate is expressed as the reference current It = Cr/n where Cr is the rated capacity declared by the manufacturer and n is the time base in hours for which the rated capacity is declared</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e1fd84eb_acdb_4b2c_b90c_e899d552a3ee</IRI>
        <Literal xml:lang="en">the quantity CRate is not used for energy-decoupled batteries like Redox Flox batteries</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e1fd84eb_acdb_4b2c_b90c_e899d552a3ee</IRI>
        <Literal xml:lang="en">DRate</Literal>
    </AnnotationAssertion>
