        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>rdfs:seeAlso</AbbreviatedIRI>
        <Literal xml:lang="en">EMMO applies the naming convension to its sub-properties of rdfs:seeAlso that their label must end with one of the following terms:
  - &apos;Match&apos;: resolvable URLs to corresponding entity in another ontology
  - &apos;Entry&apos;: resolvable URLs to a human readable resource describing the subject
  - &apos;Ref&apos;: non-resolvable reference to a human readable resource describing the subject</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
