        <IRI>http://emmo.info/emmo#EMMO_c74da218_9147_4f03_92d1_8894abca55f3</IRI>
        <Literal xml:lang="en">This concept includes only things that are purposely created by an agent.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_705f27ae_954c_4f13_98aa_18473fc52b25"/>
            <Literal xml:lang="en">From the Ancient Greek γραφή (graphḗ) which means drawing, painting, writing, a writing, description, and from γράφω (gráphō) which means scratch, carve.</Literal>
        </Annotation>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="en">The term graphical is used in etymological sense, comprising both writings and visual arts.</Literal>
