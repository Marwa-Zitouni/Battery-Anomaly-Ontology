        <Literal xml:lang="en">Number quantifying the acidic or the alkaline character of a solution, equal to the negative of the decimal logarithm of ion activity aH+ of the hydrogen cation H+
pH = −10 log(a_H+).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
