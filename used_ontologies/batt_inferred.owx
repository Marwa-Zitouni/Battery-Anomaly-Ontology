    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_c26a0340_d619_4928_b1a1_1a04e88bb89d</IRI>
        <Literal xml:lang="en">The union of all classes categorising elementary particles according to the Standard Model.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_c26a0340_d619_4928_b1a1_1a04e88bb89d</IRI>
        <Literal xml:lang="en">Disjointness comes from the fact that standard model elementary particles are entities that possess objectively distinct and singular characters.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_c26a0340_d619_4928_b1a1_1a04e88bb89d</IRI>
        <Literal xml:lang="en">Graviton is included, even if it is an hypothetical particle, to enable causality for gravitational interactions.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_c26a0340_d619_4928_b1a1_1a04e88bb89d</IRI>
        <Literal xml:lang="en">This class represents only real particles that are the input and output of a Feynman diagram, and hence respect the E²-p²c²=m²c⁴ energy-momentum equality (on the mass shell). 
In the EMMO the virtual particles (off the mass shell), the internal propagators of the interaction within a Feynman diagram, are not represented as mereological entities but as object relations (binary predicates).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_705f27ae_954c_4f13_98aa_18473fc52b25"/>
            <Literal xml:lang="en">From Latin elementārius (“elementary”), from elementum (“one of the four elements of antiquity; fundamentals”).</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
