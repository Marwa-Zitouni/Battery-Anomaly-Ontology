        <Literal xml:lang="en">material that is oxidized or reduced at an electrode in an electrochemical cell</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
