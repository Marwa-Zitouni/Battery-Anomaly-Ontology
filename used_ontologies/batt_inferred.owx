        <Literal xml:lang="en">CatholyteTank</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_9bc02662_9799_4593_906d_638a841d7352</IRI>
        <Literal xml:lang="en">a structural representation of the double layer that states that the accumulation of electric charge on the surface of the electrode is balanced by a layer of ions in the electrolyte</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_9bc02662_9799_4593_906d_638a841d7352</IRI>
        <Literal xml:lang="en">proposed by Hermann von Helmholtz in 1853</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_9bc02662_9799_4593_906d_638a841d7352</IRI>
        <Literal xml:lang="en">the first model for the double layer</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_9bc02662_9799_4593_906d_638a841d7352</IRI>
        <Literal xml:lang="en">HelmholtzModel</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_9bf40017_3f58_4030_ada7_cb37a3dfda2d</IRI>
        <Literal>https://www.wikidata.org/wiki/Q2527701</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
