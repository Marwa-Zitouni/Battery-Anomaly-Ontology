        <Literal xml:lang="en">Decibel</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_972e01b0_b017_4903_8c05_b7edda958723</IRI>
        <Literal xml:lang="en">Note that logarithmic units like decibel or neper are not univocally defines, since their definition depends on whether they are used to measure a &quot;power&quot; or a &quot;root-power&quot; quantity.

It is advisory to create a uniquely defined subclass these units for concrete usage.</Literal>
    </AnnotationAssertion>
