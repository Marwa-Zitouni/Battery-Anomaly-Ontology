        <Literal xml:lang="en">A symbolic that has parts a numerical object and a reference expressing the value of a quantity (expressed as the product of the numerical and the unit).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_b432d2d5_25f4_4165_99c5_5935a7763c1a"/>
