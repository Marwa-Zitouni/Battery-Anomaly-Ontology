    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_4ef8c0e4_1b0b_4699_a135_8c89ca289802</IRI>
