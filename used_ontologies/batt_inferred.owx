        <IRI>http://emmo.info/emmo#EMMO_223d9523_4169_4ecd_b8af_acad1215e1ff</IRI>
        <Literal xml:lang="en">Exponent</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
