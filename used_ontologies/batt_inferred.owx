        <IRI>http://emmo.info/emmo#EMMO_64aba1e5_24b7_4140_8eb4_676c35698e79</IRI>
        <Literal xml:lang="en">A language object respecting the syntactic rules of C++.</Literal>
    </AnnotationAssertion>
