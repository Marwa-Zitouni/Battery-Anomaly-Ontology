        <IRI>http://emmo.info/electrochemistry#electrochemistry_2ab7af60_da58_4243_b3bc_cbb2155cac53</IRI>
        <Literal xml:lang="en">energy delivered by a deviced under some specific charge conditions</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
