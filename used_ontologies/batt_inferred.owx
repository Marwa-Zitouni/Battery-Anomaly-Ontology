        <IRI>http://emmo.info/electrochemistry#electrochemistry_1a7fb32a_743f_4aa6_ac5a_ff7a2ba29dce</IRI>
        <Literal xml:lang="en">Electrogravimetry using an electrochemical quartz crystal microbalance.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_1a7fb32a_743f_4aa6_ac5a_ff7a2ba29dce</IRI>
        <Literal xml:lang="en">https://doi.org/10.1515/pac-2018-0109</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_1a7fb32a_743f_4aa6_ac5a_ff7a2ba29dce</IRI>
        <Literal xml:lang="en">The change of mass is, for rigid deposits, linearly proportional to the change of the reso- nance frequency of the quartz crystal, according to the Sauerbrey equation. For non- rigid deposits, corrections must be made.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
