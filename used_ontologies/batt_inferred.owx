        <IRI>http://emmo.info/emmo#Litre</IRI>
        <Literal>B51</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc"/>
