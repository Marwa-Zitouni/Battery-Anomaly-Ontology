        <IRI>http://emmo.info/emmo#EMMO_d64a491b_d160_4adf_bba1_1a3f0624f0ea</IRI>
        <Literal xml:lang="en">Mean total rectified path length travelled by a particle in the course of slowing down to rest in a given material averaged over a group of particles having the same initial energy.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
