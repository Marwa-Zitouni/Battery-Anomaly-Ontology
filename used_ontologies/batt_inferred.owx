        <IRI>http://emmo.info/electrochemistry#electrochemistry_2a2f59b7_aa16_40aa_9c8b_0de8a2720456</IRI>
        <Literal xml:lang="en">Current that is produced by other processes, for example by diffusion of charged species, is termed ‘non- faradaic current’.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_2a2f59b7_aa16_40aa_9c8b_0de8a2720456</IRI>
