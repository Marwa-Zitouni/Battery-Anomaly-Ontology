        <IRI>http://emmo.info/emmo#EMMO_22496460_c849_4bd7_8be0_9a1202506f18</IRI>
        <Literal xml:lang="en">Archetype join attaches two workpiece with geometrically defined shape together, using supplementary workpiece made of amorphous material (e.g. powder).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_22496460_c849_4bd7_8be0_9a1202506f18</IRI>
        <Literal xml:lang="en">ArchetypeJoin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
