        <IRI>http://emmo.info/electrochemistry#electrochemistry_f57a7dac_2ec2_4d51_b697_01a844c4467f</IRI>
        <Literal xml:lang="en">considers the effects of specific adsorbed ions in the double layer</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
