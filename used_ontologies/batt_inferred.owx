        <Literal>http://dbpedia.org/page/Hectare</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84"/>
        <IRI>http://emmo.info/emmo#Hectare</IRI>
        <Literal xml:lang="en">A non-SI metric unit of area defined as the square with 100-metre sides.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#Hectare</IRI>
        <Literal xml:lang="en">The customary metric unit of land area, equal to 100 ares. One hectare is a square hectometer, that is, the area of a square 100 meters on each side: exactly 10 000 square meters or approximately 107 639.1 square feet, 11 959.9 square yards, or 2.471 054 acres.

-- QUDT</Literal>
    </AnnotationAssertion>
