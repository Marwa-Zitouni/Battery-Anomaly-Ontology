        <Literal xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=114-03-03</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_dc6abae7_39b0_4d22_b52e_14d088a4bd5f</IRI>
        <Literal xml:lang="en">type of capacitor characterized by high capacitance, high specific and volumetric energy density, and low voltage limits</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d"/>
