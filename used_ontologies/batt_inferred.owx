        <IRI>http://emmo.info/emmo#EMMO_19608340_178c_4bfd_bd4d_0d3b935c6fec</IRI>
        <Literal>The scientist that connects an equation to a physical phenomenon.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_705f27ae_954c_4f13_98aa_18473fc52b25"/>
            <Literal xml:lang="en">From Latin cognitio (“knowledge, perception, a judicial examination, trial”), from cognitus, past participle of cognoscere (“to know”), from co- (“together”) + *gnoscere, older form of noscere (“to know”</Literal>
        </Annotation>
