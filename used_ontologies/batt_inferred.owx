        </Annotation>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_8a8f664b_dc59_4e00_ae00_81fdf1e1d12e</IRI>
        <Literal xml:lang="en">The term &quot;Uniform Resource Locator&quot; (URL) refers to the subset of URIs that, in addition to identifying a resource, provide a means of locating the resource by describing its primary access mechanism (e.g., its network &quot;location&quot;).</Literal>
    </AnnotationAssertion>
