        <Literal xml:lang="en">Vector quantity with magnitude equal to the heat flow rate dΦ through a surface element divided by the area dA of the element, and direction eφ in the direction of propagation of heat.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
