        <IRI>http://emmo.info/electrochemistry#electrochemistry_057bb143_639c_472b_99ed_ffa1867f6e63</IRI>
        <Literal xml:lang="en">extremely resistant to many chemicals, impermeable to gases and liquids, and has good electrical conductivity, high hardness and strength, and biocompatibility</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://purl.org/dc/terms/source"/>
