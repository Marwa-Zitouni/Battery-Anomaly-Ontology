        <Literal>L</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652"/>
        <IRI>http://emmo.info/emmo#Litre</IRI>
        <Literal>l</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84"/>
        <IRI>http://emmo.info/emmo#Litre</IRI>
        <Literal xml:lang="en">A non-SI unit of volume defined as 1 cubic decimetre (dm3),</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#Litre</IRI>
        <Literal xml:lang="en">The litre (American spelling: `liter`; SI symbol l or L) is a non-SI metric system unit of volume equal to 1 `cubic decimetre` (dm³), 1,000 cubic centimetres (cm³) or 1/1000 `cubic metre`. If the lower case &quot;L&quot; is used as the symbol, it is sometimes rendered as a cursive &quot;l&quot; to help distinguish it from the capital &quot;I&quot;, although this usage has no official approval by any international bureau.

-- QUDT</Literal>
    </AnnotationAssertion>
