        <Literal xml:lang="en">https://en.wikipedia.org/wiki/Standard_hydrogen_electrode</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_2a40b878_7d09_49db_91b2_d0ee30192284</IRI>
        <Literal xml:lang="en">https://goldbook.iupac.org/terms/view/S05917</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_2a40b878_7d09_49db_91b2_d0ee30192284</IRI>
        <Literal xml:lang="en">Potential of a platinum electrode in a theoretical ideal solution (the current standard for zero potential for all temperatures)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_2a40b878_7d09_49db_91b2_d0ee30192284</IRI>
        <Literal xml:lang="en">SHE</Literal>
