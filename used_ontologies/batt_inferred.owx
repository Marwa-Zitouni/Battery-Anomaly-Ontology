    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf</IRI>
        <Literal xml:lang="en">Conversion formula:

    nonsi_coherent_unit = si_coherent_unit * multiplier + offset</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_8189b42e_0995_423a_a26c_51168b27c3cf</IRI>
        <Literal xml:lang="en">hasSIConversionMultiplier</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc"/>
        <IRI>http://emmo.info/emmo#EMMO_81e767f1_59b1_4d7a_bf69_17f322241831</IRI>
        <Literal>http://qudt.org/vocab/quantitykind/MagneticDipoleMoment</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f"/>
        <IRI>http://emmo.info/emmo#EMMO_81e767f1_59b1_4d7a_bf69_17f322241831</IRI>
        <Literal>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-55</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578"/>
        <IRI>http://emmo.info/emmo#EMMO_81e767f1_59b1_4d7a_bf69_17f322241831</IRI>
        <Literal>10-9.1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578"/>
        <IRI>http://emmo.info/emmo#EMMO_81e767f1_59b1_4d7a_bf69_17f322241831</IRI>
        <Literal>6-30</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_81e767f1_59b1_4d7a_bf69_17f322241831</IRI>
        <Literal xml:lang="en">Vector quantity μ causing a change to its energy ΔW in an external magnetic field of field flux density B:

    ΔW = −μ · B</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
        <IRI>http://emmo.info/emmo#EMMO_81e767f1_59b1_4d7a_bf69_17f322241831</IRI>
        <Literal>http://goldbook.iupac.org/terms/view/M03688</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/emmo#EMMO_81e767f1_59b1_4d7a_bf69_17f322241831</IRI>
        <Literal xml:lang="en">For an atom or nucleus, this energy is quantized and can be written as:

    W = g μ M B

where g is the appropriate g factor, μ is mostly the Bohr magneton or nuclear magneton, M is magnetic quantum number, and B is magnitude of the magnetic flux density.

-- ISO 80000</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_81e767f1_59b1_4d7a_bf69_17f322241831</IRI>
        <Literal xml:lang="en">MagneticDipoleMoment</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_820619ca_b23e_4c7a_8543_18a17722abc0</IRI>
        <Literal xml:lang="en">ElementaryFermion</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc"/>
        <IRI>http://emmo.info/emmo#EMMO_8219a082_9443_4374_8038_6459d5cf4ce9</IRI>
        <Literal>https://qudt.org/vocab/quantitykind/AcceptorDensity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54"/>
        <IRI>http://emmo.info/emmo#EMMO_8219a082_9443_4374_8038_6459d5cf4ce9</IRI>
        <Literal>https://www.wikidata.org/wiki/Q105979968</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578"/>
        <IRI>http://emmo.info/emmo#EMMO_8219a082_9443_4374_8038_6459d5cf4ce9</IRI>
        <Literal>12-29.5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_8219a082_9443_4374_8038_6459d5cf4ce9</IRI>
        <Literal xml:lang="en">quotient of number of acceptor levels and volume.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_8219a082_9443_4374_8038_6459d5cf4ce9</IRI>
        <Literal xml:lang="en">AcceptorDensity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375</IRI>
        <Literal xml:lang="en">A unit whos numerical factor in front of the product of base units is NOT equal to one.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375</IRI>
        <Literal xml:lang="en">A non-SI coherent can be expressed in terms of its corresponding SI coherent unit, as

    nonsi_coherent_unit = si_coherent_unit * multiplier + offset

where `multiplier` and `offset` are specified via the &apos;hasConversionMultiplier&apos; and &apos;hasConversionOffset&apos; data properties, respectively.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_8246541a_f1f6_4d03_8bd7_fc6b76d17375</IRI>
        <Literal xml:lang="en">SINonCoherentUnit</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_82d6c4b3_a037_49de_9622_0407af40bdeb</IRI>
        <Literal xml:lang="en">ThirdGenerationFermion</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_3aa37f92_8dc5_4ee4_8438_e41e6ae20c62"/>
        <IRI>http://emmo.info/emmo#EMMO_82fc8506_1f84_4add_9683_abea077bd1e3</IRI>
        <Literal xml:lang="en">https://www.iso.org/obp/ui/#iso:std:iso:9000:ed-3:v1:en:term:3.4.2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_964568dd_64d2_454b_a12f_ac389f1c5e7f"/>
        <IRI>http://emmo.info/emmo#EMMO_82fc8506_1f84_4add_9683_abea077bd1e3</IRI>
        <Literal xml:lang="en">https://www.iso.org/obp/ui/#iso:std:iso:14040:ed-2:v1:en:term:3.9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_82fc8506_1f84_4add_9683_abea077bd1e3</IRI>
        <Literal xml:lang="en">The overall lifetime of an holistic that has been the output of an intentional process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/emmo#EMMO_82fc8506_1f84_4add_9683_abea077bd1e3</IRI>
        <Literal xml:lang="en">This concepts encompass the overall lifetime of a product.
Is temporaly fundamental, meaning that it can have other products as holistic spatial parts, but its holistic temporal parts are not products. In other words, the individual must encompass the whole lifetime from creation to disposal.
A product can be a tangible object (e.g. a manufactured object), a process (e.g. service). It can be the outcome of a natural or an artificially driven process.
It must have and initial stage of its life that is also an outcome of a intentional process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_82fc8506_1f84_4add_9683_abea077bd1e3</IRI>
        <Literal xml:lang="en">Output</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_705f27ae_954c_4f13_98aa_18473fc52b25"/>
            <Literal xml:lang="en">From Latin productum ‘something produced’, derived from Latin producere, from pro- ‘forward’ + ducere ‘to lead’.</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_82fc8506_1f84_4add_9683_abea077bd1e3</IRI>
        <Literal xml:lang="en">Product</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_8303a247_f9d9_4616_bdcd_f5cbd7b298e3</IRI>
        <Literal xml:lang="en">An bonded atom that shares at least one electron to the atom-based entity of which is part of.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/emmo#EMMO_8303a247_f9d9_4616_bdcd_f5cbd7b298e3</IRI>
        <Literal xml:lang="en">A real bond between atoms is always something hybrid between covalent, metallic and ionic.

In general, metallic and ionic bonds have atoms sharing electrons.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/emmo#EMMO_8303a247_f9d9_4616_bdcd_f5cbd7b298e3</IRI>
        <Literal xml:lang="en">The bond types that are covered by this definition are the strong electonic bonds: covalent, metallic and ionic.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/emmo#EMMO_8303a247_f9d9_4616_bdcd_f5cbd7b298e3</IRI>
        <Literal xml:lang="en">This class can be used to represent molecules as simplified quantum systems, in which outer molecule shared electrons are un-entangled with the inner shells of the atoms composing the molecule.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_8303a247_f9d9_4616_bdcd_f5cbd7b298e3</IRI>
        <Literal xml:lang="en">BondedAtom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc"/>
        <IRI>http://emmo.info/emmo#EMMO_830b59f7_d047_438c_90cd_62845749efcb</IRI>
        <Literal>http://qudt.org/vocab/quantitykind/InternalEnergy</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578"/>
        <IRI>http://emmo.info/emmo#EMMO_830b59f7_d047_438c_90cd_62845749efcb</IRI>
        <Literal>5.20-2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_830b59f7_d047_438c_90cd_62845749efcb</IRI>
        <Literal xml:lang="en">A state quantity equal to the difference between the total energy of a system and the sum of the macroscopic kinetic and potential energies of the system.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
