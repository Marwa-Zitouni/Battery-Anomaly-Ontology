        <Literal xml:lang="en">https://en.wikipedia.org/wiki/Faradaic_current</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_2a2f59b7_aa16_40aa_9c8b_0de8a2720456</IRI>
        <Literal xml:lang="en">https://goldbook.iupac.org/terms/view/F02321</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
