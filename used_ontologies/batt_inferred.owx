        <Literal xml:lang="en">ElectricInductance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc"/>
        <IRI>http://emmo.info/emmo#EMMO_04cf0295_3e8f_4693_a87f_3130d125cf05</IRI>
        <Literal>http://qudt.org/vocab/quantitykind/Weight</Literal>
    </AnnotationAssertion>
