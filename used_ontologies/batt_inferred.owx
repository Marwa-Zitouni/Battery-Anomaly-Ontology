        <Literal xml:lang="en">HardCarbonElectrode</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_634467ad_feed_4979_adb2_877d98fe1768</IRI>
        <Literal xml:lang="en">any junction between two electrolyte solutions of different composition.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_634467ad_feed_4979_adb2_877d98fe1768</IRI>
        <Literal xml:lang="en">https://goldbook.iupac.org/terms/view/L03584</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_634467ad_feed_4979_adb2_877d98fe1768</IRI>
        <Literal xml:lang="en">Across such a junction there arises a potential difference, called the liquid junction potential.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_634467ad_feed_4979_adb2_877d98fe1768</IRI>
        <Literal xml:lang="en">In the operational pH cell the junction is between the test, or pH standard, solution and the filling solution or the bridge solution of the reference electrode.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_634467ad_feed_4979_adb2_877d98fe1768</IRI>
        <Literal xml:lang="en">LiquidJunction</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54"/>
