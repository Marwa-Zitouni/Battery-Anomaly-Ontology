    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_f509645f_eb27_470e_9112_7ab828ed40d3</IRI>
