    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_c7013b53_3071_410b_a5e4_a8d266dcdfb5</IRI>
        <Literal xml:lang="en">An icon that imitates one representative character of the object. It share external similarities with the object, but not necessarily the same internal logical structure.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_b432d2d5_25f4_4165_99c5_5935a7763c1a"/>
        <IRI>http://emmo.info/emmo#EMMO_c7013b53_3071_410b_a5e4_a8d266dcdfb5</IRI>
        <Literal xml:lang="en">A data based model is only a functional icon, since it provide the same relations between the properties of the object (e.g., it can predict some properties as function of others) but is not considering the internal mechanisms (i.e., it can ignore the physics).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_b432d2d5_25f4_4165_99c5_5935a7763c1a"/>
        <IRI>http://emmo.info/emmo#EMMO_c7013b53_3071_410b_a5e4_a8d266dcdfb5</IRI>
        <Literal xml:lang="en">A guinea pig.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_c7013b53_3071_410b_a5e4_a8d266dcdfb5</IRI>
        <Literal xml:lang="en">An icon that focusing WHAT the object does.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/emmo#EMMO_c7013b53_3071_410b_a5e4_a8d266dcdfb5</IRI>
        <Literal xml:lang="en">This subclass of icon inspired by Peirceian category (c) the metaphor, which represents the representative character of a sign by representing a parallelism in something else.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_705f27ae_954c_4f13_98aa_18473fc52b25"/>
            <Literal xml:lang="en">From Latin functiō (“performance, execution”), from functus, perfect participle of fungor (“to perform, execute, discharge”).</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
