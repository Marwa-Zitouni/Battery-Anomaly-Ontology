        <IRI>http://emmo.info/emmo#EMMO_6470bbfa_04a6_4360_9534_1aa18d68329b</IRI>
        <Literal xml:lang="en">A Uniform Resource Identifier (URI) is a compact sequence of characters that identifies an abstract or physical resource.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
