        <Literal xml:lang="en">An atom_based state defined by an exact number of e-bonded atomic species and an electron cloud made of the shared electrons.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_b432d2d5_25f4_4165_99c5_5935a7763c1a"/>
