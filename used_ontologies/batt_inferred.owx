        <IRI>http://emmo.info/electrochemistry#electrochemistry_f6341d7d_7620_48f5_97b2_99b55c349169</IRI>
        <Literal xml:lang="en">ActiveMaterialParticleCracking</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_f693b744_930c_42ac_8e6f_627b22c6da3f</IRI>
        <Literal xml:lang="en">a system for measuing electric current</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_b432d2d5_25f4_4165_99c5_5935a7763c1a"/>
