        <Literal xml:lang="en">a coin case with a nominal diameter of 6.8 mm and a height of 2.1 mm</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_15ec346a_6d3c_4161_95e1_9cf889965f85</IRI>
        <Literal>R60</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
