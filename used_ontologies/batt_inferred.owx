    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_1e877c70_3b01_45a8_a8f6_8ce4f6a24660</IRI>
        <Literal xml:lang="en">A perspective in which entities are represented according to the variation of their properties.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_1e877c70_3b01_45a8_a8f6_8ce4f6a24660</IRI>
        <Literal xml:lang="en">A data is a causal object whose variations (non-uniformity) can be recognised and eventually interpreted.
A data can be of different physical types (e.g., matter, wave, atomic excited states).
How the variations are recognised and eventually decoded depends on the interpreting rules that characterise that type of data.
Variations are pure physical variations and do not necessarily possess semantic meaning.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_1e877c70_3b01_45a8_a8f6_8ce4f6a24660</IRI>
        <Literal xml:lang="en">The covering axiom that defines the data class discriminates within all the possible causal objects between encoded or non encoded.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <IRI>http://emmo.info/emmo#EMMO_1e877c70_3b01_45a8_a8f6_8ce4f6a24660</IRI>
        <Literal xml:lang="en">Luciano Floridi, &quot;Information - A very Short Introduction&quot;, Oxford University Press., (2010) ISBN 978-0199551378</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_1e877c70_3b01_45a8_a8f6_8ce4f6a24660</IRI>
        <Literal xml:lang="en">Contrast</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_705f27ae_954c_4f13_98aa_18473fc52b25"/>
            <Literal xml:lang="en">From Greek, nominative plural form of δεδομένο (dedoméno) (data, information)</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
