        <IRI>http://emmo.info/electrochemistry#electrochemistry_e4a221e0_afc9_4464_91d4_e0c8ecdf79e8</IRI>
        <Literal xml:lang="en">https://doi.org/10.1351/goldbook.P04464</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e4a221e0_afc9_4464_91d4_e0c8ecdf79e8</IRI>
        <Literal xml:lang="en">This term is used in dynamic voltammetric techniques providing a peak-shaped current response (linear-sweep voltammetry, triangular-wave voltammetry, cyclic voltammetry, AC voltammetry, differential pulse voltammetry, square-wave voltammetry, stripping voltamme- try and derivative techniques).</Literal>
    </AnnotationAssertion>
