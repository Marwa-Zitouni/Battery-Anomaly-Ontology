    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e9639083_e9c5_4d0a_97e8_be1e139c179f</IRI>
        <Literal>https://www.wikidata.org/wiki/Q11778221</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e9639083_e9c5_4d0a_97e8_be1e139c179f</IRI>
        <Literal xml:lang="en">titration in which the electric conductivity of a solution is measured as a function of the amount of titrant added</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e9639083_e9c5_4d0a_97e8_be1e139c179f</IRI>
        <Literal xml:lang="en">https://doi.org/10.1515/pac-2018-0109</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e9639083_e9c5_4d0a_97e8_be1e139c179f</IRI>
        <Literal xml:lang="en">The equivalence-point is obtained as the intersection of linear parts of the conductance G, versus titrant volume V, curve (see</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e9639083_e9c5_4d0a_97e8_be1e139c179f</IRI>
        <Literal xml:lang="en">The method can be used for deeply coloured or turbid solutions. Acid-base and precipita- tion reactions are most frequently used.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e9639083_e9c5_4d0a_97e8_be1e139c179f</IRI>
        <Literal xml:lang="en">The method is based on replacing an ionic species of the analyte with another species, cor- responding to the titrant or the product with significantly different conductance.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e9639083_e9c5_4d0a_97e8_be1e139c179f</IRI>
        <Literal xml:lang="en">ConductometricTitration</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e9fd9ef9_adfe_46cb_b2f9_4558468a25e7</IRI>
        <Literal xml:lang="en">defined by j0 = i0/A, where i0 is the exchange current of the electrode reaction and A is usually taken as the geometric area of the electrode</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e9fd9ef9_adfe_46cb_b2f9_4558468a25e7</IRI>
        <Literal>https://en.wikipedia.org/wiki/Exchange_current_density</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_e9fd9ef9_adfe_46cb_b2f9_4558468a25e7</IRI>
        <Literal>https://goldbook.iupac.org/terms/view/M03777</Literal>
    </AnnotationAssertion>
