    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_8533871a_01e4_4935_8c7b_cedf8fcc3fa3</IRI>
        <Literal xml:lang="en">An icon that not only resembles the object, but also can express some of the object&apos;s functions.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_b432d2d5_25f4_4165_99c5_5935a7763c1a"/>
        <IRI>http://emmo.info/emmo#EMMO_8533871a_01e4_4935_8c7b_cedf8fcc3fa3</IRI>
        <Literal xml:lang="en">A small scale replica of a plane tested in a wind gallery shares the same functionality in terms of aerodynamic behaviour of the bigger one.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_b432d2d5_25f4_4165_99c5_5935a7763c1a"/>
        <IRI>http://emmo.info/emmo#EMMO_8533871a_01e4_4935_8c7b_cedf8fcc3fa3</IRI>
        <Literal xml:lang="en">Pinocchio is a functional icon of a boy since it imitates the external behaviour without having the internal biological structure of a human being (it is made of magic wood...).</Literal>
    </AnnotationAssertion>
