        <Literal xml:lang="en">An interfacial reaction that necessarily involves a charge-transfer step.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
