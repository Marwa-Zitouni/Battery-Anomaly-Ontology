        <Literal>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-04-52</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578"/>
        <IRI>http://emmo.info/emmo#EMMO_8040a6f6_4736_4dd2_8d1c_f2c13cb77a71</IRI>
