        <Literal xml:lang="en">hasStringValue</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc"/>
        <IRI>http://emmo.info/emmo#EMMO_030ce585_429a_4cfb_95c2_8364e58a1ebb</IRI>
        <Literal>https://qudt.org/vocab/quantitykind/GyromagneticRatio</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
