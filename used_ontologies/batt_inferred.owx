        <IRI>http://emmo.info/emmo#Lumen</IRI>
        <Literal>lm</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25"/>
