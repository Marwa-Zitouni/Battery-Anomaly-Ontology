        <Literal xml:lang="en">A participant that is the driver of the process.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_b432d2d5_25f4_4165_99c5_5935a7763c1a"/>
        <IRI>http://emmo.info/emmo#EMMO_2480b72b_db8d_460f_9a5f_c2912f979046</IRI>
        <Literal xml:lang="en">A catalyst. A bus driver. A substance that is initiating a reaction that would not occur without its presence.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
