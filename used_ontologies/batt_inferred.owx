    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/emmo#EMMO_28fbea28_2204_4613_87ff_6d877b855fcd</IRI>
        <Literal xml:lang="en">Arrays are ordered objects, since they are a subclasses of Arrangement.</Literal>
