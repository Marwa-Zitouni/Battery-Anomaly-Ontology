        <IRI>http://emmo.info/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652</IRI>
        <Literal xml:lang="en">Unified Code for Units of Measure (UCUM).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652</IRI>
        <Literal xml:lang="en">The Unified Code for Units of Measure (UCUM) is a code system intended to include all units of measures being contemporarily used in international science, engineering, and business. The purpose is to facilitate unambiguous electronic communication of quantities together with their units.</Literal>
    </AnnotationAssertion>
