        </Annotation>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_1900143f_cbc0_415f_9057_9382022a7bfe</IRI>
        <Literal xml:lang="en">rotational frequency of a rotating component in a rotating disk electrode</Literal>
    </AnnotationAssertion>
