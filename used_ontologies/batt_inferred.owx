        <Literal xml:lang="en">MassAmountOfSubstanceUnit</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_0f6f0120_c079_4d95_bb11_4ddee05e530e</IRI>
        <Literal xml:lang="en">Result of a measurement.

A set of quantites being attributed to a measurand (measured quantitative property) together with any other available relevant information, like measurement uncertainty.

-- VIM</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_bb49844b_45d7_4f0d_8cae_8e552cbc20d6"/>
        <IRI>http://emmo.info/emmo#EMMO_0f6f0120_c079_4d95_bb11_4ddee05e530e</IRI>
        <Literal xml:lang="en">measurement result</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_0f6f0120_c079_4d95_bb11_4ddee05e530e</IRI>
        <Literal xml:lang="en">A measurement result generally contains “relevant information” about the set of measured quantity properties, such that some may be more representative of the measured quantity than others. This may be expressed in the form of a probability density function (pdf).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_0f6f0120_c079_4d95_bb11_4ddee05e530e</IRI>
        <Literal xml:lang="en">A measurement result has the measured quantity, measurement uncertainty and other relevant attributes as holistic parts.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_0f6f0120_c079_4d95_bb11_4ddee05e530e</IRI>
        <Literal xml:lang="en">MeasurementResult</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13"/>
        <IRI>http://emmo.info/emmo#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360</IRI>
        <Literal xml:lang="en">A causal chain is an ordered causal sequence of entities that does not host any bifurcation within itself (a chain). A chain can only be partitioned in time.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360</IRI>
        <Literal xml:lang="en">The class of entities that possess a temporal structure but no spatial structure.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_b432d2d5_25f4_4165_99c5_5935a7763c1a"/>
        <IRI>http://emmo.info/emmo#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360</IRI>
        <Literal xml:lang="en">An electron with at least one causal interaction with another particle.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c6e77b51_681b_4d04_b20d_a08f2b977470"/>
        <IRI>http://emmo.info/emmo#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360</IRI>
        <Literal xml:lang="en">hasTemporalPart min 2 (Elementary or Quantum)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_705f27ae_954c_4f13_98aa_18473fc52b25"/>
            <Literal xml:lang="en">From Old French chaine, chaene (“chain”), from Latin catēna (“chain”).</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360</IRI>
        <Literal xml:lang="en">CausalChain</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_705f27ae_954c_4f13_98aa_18473fc52b25"/>
            <Literal xml:lang="en">From Latin elementārius (“elementary”), from elementum (“one of the four elements of antiquity; fundamentals”).</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_0f795e3e_c602_4577_9a43_d5a231aa1360</IRI>
        <Literal xml:lang="en">Elementary</Literal>
