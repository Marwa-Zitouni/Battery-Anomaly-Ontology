    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84"/>
        <IRI>http://emmo.info/emmo#AstronomicalUnit</IRI>
        <Literal xml:lang="en">One astronomical unit is defined as exactly 149597870700 m, which is roughly the distance from earth to sun.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64"/>
