        <Literal>http://qudt.org/vocab/unit/HR</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652"/>
        <IRI>http://emmo.info/emmo#Hour</IRI>
        <Literal>h</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84"/>
        <IRI>http://emmo.info/emmo#Hour</IRI>
        <Literal xml:lang="en">Measure of time defined as 3600 seconds.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#Hour</IRI>
        <Literal xml:lang="en">The hour (common symbol: h or hr) is a unit of measurement of time. In modern usage, an hour comprises 60 minutes, or 3,600 seconds. It is approximately 1/24 of a mean solar day. An hour in the Universal Coordinated Time (UTC) time standard can include a negative or positive leap second, and may therefore have a duration of 3,599 or 3,601 seconds for adjustment purposes. Although it is not a standard defined by the International System of Units, the hour is a unit accepted for use with SI, represented by the symbol h.

-- QUDT</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
        <IRI>http://emmo.info/emmo#Hour</IRI>
        <Literal>https://doi.org/10.1351/goldbook.H02866</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
