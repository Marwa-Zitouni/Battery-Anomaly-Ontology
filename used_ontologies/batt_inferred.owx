        <Literal xml:lang="en">In geometrical optics, vergence describes the curvature of optical wavefronts.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
