        <Literal xml:lang="en">this model fails for highly charged double layers</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_fa54f95d_b49e_43b5_84c3_35520d0fb2f6</IRI>
        <Literal xml:lang="en">GouyChapmanModel</Literal>
    </AnnotationAssertion>
