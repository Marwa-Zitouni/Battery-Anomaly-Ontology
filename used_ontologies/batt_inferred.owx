    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_5afa28f0_8c9f_4fcd_8f67_805bd2f9c068</IRI>
