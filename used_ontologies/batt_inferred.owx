        <IRI>http://emmo.info/emmo#EMMO_bb49844b_45d7_4f0d_8cae_8e552cbc20d6</IRI>
        <Literal xml:lang="en">quantity value (term in VIM that corresponds to Quantity in EMMO)</Literal>
    </AnnotationAssertion>
