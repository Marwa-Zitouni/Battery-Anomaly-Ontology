    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_74a096dd_cc83_4c7e_b704_0541620ff18d</IRI>
