        <IRI>http://emmo.info/electrochemistry#electrochemistry_9bf40017_3f58_4030_ada7_cb37a3dfda2d</IRI>
        <Literal xml:lang="en">impedance of a linear circuit&apos;s Thévenin representation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_9bf40017_3f58_4030_ada7_cb37a3dfda2d</IRI>
        <Literal xml:lang="en">https://en.wikipedia.org/wiki/Internal_resistance</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_9bf40017_3f58_4030_ada7_cb37a3dfda2d</IRI>
        <Literal xml:lang="en">According to to Thévenin&apos;s theorem can any linear electric curcuit be replaced with a voltage source in series with an impedance. This impedance is for historical reasons termed &quot;internal resistance&quot;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_9bf40017_3f58_4030_ada7_cb37a3dfda2d</IRI>
        <Literal xml:lang="en">For batteries, it the internal resistance the resistance of the cell.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_9bf40017_3f58_4030_ada7_cb37a3dfda2d</IRI>
        <Literal xml:lang="en">InternalResistance</Literal>
