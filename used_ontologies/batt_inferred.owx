        <Literal xml:lang="en">Boolean</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_54ee6b5e_5261_44a8_86eb_5717e7fdb9d0</IRI>
        <Literal xml:lang="en">The class of general mathematical symbolic objects respecting mathematical syntactic rules.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/emmo#EMMO_54ee6b5e_5261_44a8_86eb_5717e7fdb9d0</IRI>
        <Literal>A mathematical object in this branch is not representing a concept but an actual graphical object built using mathematcal symbols arranged in some way, according to math conventions.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_54ee6b5e_5261_44a8_86eb_5717e7fdb9d0</IRI>
        <Literal xml:lang="en">Mathematical</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84"/>
        <IRI>http://emmo.info/emmo#EMMO_55354438_7000_4284_b1b9_59d60c2261b9</IRI>
        <Literal xml:lang="en">A proper part relation with domain restricted to items.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_55354438_7000_4284_b1b9_59d60c2261b9</IRI>
        <Literal xml:lang="en">hasPortionPart</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_31252f35_c767_4b97_a877_1235076c3e13"/>
        <IRI>http://emmo.info/emmo#EMMO_555d0261_da5e_4301_b7f9_46f604a32e91</IRI>
        <Literal xml:lang="en">Direct causality is a concept that capture the idea of contact between two entities, given the fact that there are no causal intermediaries between them. It requires that at least a quantum of the causing entity is direct cause of a quantum of the caused entity.
It does not exclude the possibility of indirect causal routes between proper parts of the two entities.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_555d0261_da5e_4301_b7f9_46f604a32e91</IRI>
        <Literal xml:lang="en">A causal relation between the causing and the effected entities occurring without intermediaries.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_555d0261_da5e_4301_b7f9_46f604a32e91</IRI>
        <Literal xml:lang="en">Direct cause is irreflexive.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f"/>
        <IRI>http://emmo.info/emmo#EMMO_555d0261_da5e_4301_b7f9_46f604a32e91</IRI>
        <Literal xml:lang="en">Direct cause provides the edges for the transitive restriction of the direct acyclic causal graph whose nodes are the quantum entities.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_555d0261_da5e_4301_b7f9_46f604a32e91</IRI>
        <Literal xml:lang="en">isDirectCauseOf</Literal>
    </AnnotationAssertion>
