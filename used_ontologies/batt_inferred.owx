        <IRI>http://emmo.info/emmo#Hour</IRI>
        <Literal xml:lang="en">Hour</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_0b1cbe60_d380_4787_b92e_be26bdacf2c2"/>
        <IRI>http://emmo.info/emmo#Joule</IRI>
        <Literal>JOU</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
