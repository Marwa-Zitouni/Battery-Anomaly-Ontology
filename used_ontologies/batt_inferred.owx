        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#anyURI">http://en.wikipedia.org/wiki/Kilogram?oldid=493633626</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
        <IRI>http://emmo.info/emmo#Kilogram</IRI>
        <Literal>https://doi.org/10.1351/goldbook.K03391</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <IRI>http://emmo.info/emmo#Kilogram</IRI>
        <Literal xml:lang="en">Kilogram</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
