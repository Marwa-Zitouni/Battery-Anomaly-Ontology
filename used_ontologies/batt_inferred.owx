        <Literal xml:lang="en">ElectricCurrentMeasurement</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_15b852b5_19cc_49ab_849f_7df6175fb2be</IRI>
        <Literal xml:lang="en">https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=114-03-18</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://purl.org/dc/terms/source"/>
            <Literal>International Electrotechnical Commission (IEC), IEC 60050 - International Electrotechnical Vocabulary, retrieved from: https://www.electropedia.org</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_15b852b5_19cc_49ab_849f_7df6175fb2be</IRI>
        <Literal xml:lang="en">electrolyte on the cathode side of an electrochemical cell that is divided into compartments.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://purl.org/dc/terms/source"/>
            <Literal>A. J. Bard, G. Inzelt, and F. Scholz, Eds., Electrochemical Dictionary, 2nd Edition. Berlin: Springer-Verlag, 2012. DOI: https://doi.org/10.1007/978-3-642-29551-5</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_15b852b5_19cc_49ab_849f_7df6175fb2be</IRI>
        <Literal xml:lang="en">Electrolyte solution in the cathodic compartment of an electrolysis cell or galvanic cell, i.e., in that part of the cell where the cathode is placed.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_15b852b5_19cc_49ab_849f_7df6175fb2be</IRI>
        <Literal xml:lang="en">Catholyte</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
