    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/emmo#EMMO_80fe82d4_f4c1_43a1_98dc_ee5fc7927e19</IRI>
        <Literal xml:lang="en">At about 25 °C aqueous solutions with:
pH &lt; 7 are acidic;
pH = 7 are neutral;
pH &gt; 7 are alkaline.
At temperatures far from 25 °C the pH of a neutral solution differs significantly from 7.</Literal>
    </AnnotationAssertion>
