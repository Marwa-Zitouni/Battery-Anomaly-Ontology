    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/emmo#EMMO_008fd3b2_4013_451f_8827_52bceab11841</IRI>
        <Literal xml:lang="en">A &apos;Process&apos;, that has participant an &apos;Interpreter&apos;, that is aimed to produce a &apos;Sign&apos; representing another participant, the &apos;Object&apos;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_b432d2d5_25f4_4165_99c5_5935a7763c1a"/>
        <IRI>http://emmo.info/emmo#EMMO_008fd3b2_4013_451f_8827_52bceab11841</IRI>
        <Literal xml:lang="en">Me looking a cat and saying loud: &quot;Cat!&quot; -&gt; the semiosis process

me -&gt; interpreter
cat -&gt; object (in Peirce semiotics)
the cat perceived by my mind -&gt; interpretant
&quot;Cat!&quot; -&gt; sign, the produced sign</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>http://emmo.info/emmo#EMMO_008fd3b2_4013_451f_8827_52bceab11841</IRI>
        <Literal xml:lang="en">Semiosis</Literal>
    </AnnotationAssertion>
