        <Literal xml:lang="en">https://en.wikipedia.org/wiki/Hydrodynamic_voltammetry</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_fe015383_afb3_44a6_ae86_043628697aa2"/>
