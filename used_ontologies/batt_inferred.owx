        <IRI>http://emmo.info/electrochemistry#electrochemistry_9ee6e728_e8f5_4b36_a045_d63da69dfc85</IRI>
        <Literal>https://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=482-05-44</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://purl.org/dc/terms/source"/>
            <Literal>International Electrotechnical Commission (IEC), IEC 60050 - International Electrotechnical Vocabulary, retrieved from: https://www.electropedia.org</Literal>
        </Annotation>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_9ee6e728_e8f5_4b36_a045_d63da69dfc85</IRI>
        <Literal xml:lang="en">continued charging of a fully charged secondary cell or battery</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty IRI="http://purl.org/dc/terms/source"/>
            <Literal>International Electrotechnical Commission (IEC), IEC 60050 - International Electrotechnical Vocabulary, retrieved from: https://www.electropedia.org</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
