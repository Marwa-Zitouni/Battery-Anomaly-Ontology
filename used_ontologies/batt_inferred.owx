        <IRI>http://emmo.info/electrochemistry#electrochemistry_9d7e5fea_a49a_4a19_a8de_8e24c60e420c</IRI>
        <Literal xml:lang="en">NernstEinsteinEquation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
