        <Literal xml:lang="en">an equation relating the limiting molar conductivity Λ_m^0  to the ionic diffusion coefficients.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://emmo.info/emmo#EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_9d7e5fea_a49a_4a19_a8de_8e24c60e420c</IRI>
        <Literal xml:lang="en">https://en.wikipedia.org/wiki/Einstein_relation_(kinetic_theory)#Nernst%E2%80%93Einstein_equation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_9d7e5fea_a49a_4a19_a8de_8e24c60e420c</IRI>
        <Literal xml:lang="en">\Lambda_m^0 = (F^2/(R*T)) * (v_{+} * z_{+}^2 * D_{+} + v_{–} * z_{–}^2 * D_{–})</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <IRI>http://emmo.info/electrochemistry#electrochemistry_9d7e5fea_a49a_4a19_a8de_8e24c60e420c</IRI>
        <Literal xml:lang="en">KohlrauschsLaw</Literal>
    </AnnotationAssertion>
