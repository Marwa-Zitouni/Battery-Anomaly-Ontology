    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://emmo.info/emmo#EMMO_ee7ddcb8_ad8e_4ff7_a09f_889d8edf8f8b</IRI>
        <Literal xml:lang="en">At a fixed point in a medium, the direction of propagation of heat is opposite to the temperature gradient. At a point on the surface separating two media with different temperatures, the direction of propagation of heat is normal to the surface, from higher to lower temperatures.</Literal>
