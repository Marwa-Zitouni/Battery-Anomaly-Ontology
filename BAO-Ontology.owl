    <rdfs:label xml:lang="en">has confidence</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a detection event to a method-specific confidence assessment.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionEvent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Confidence"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#confidenceOf"/>
  </rdf:Description>
