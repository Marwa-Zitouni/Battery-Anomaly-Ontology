    <rdfs:label xml:lang="en">MetallicParticleContamination</rdfs:label>
    <rdfs:comment xml:lang="en">Metallic particles embedded during manufacturing, piercing the separator over time.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SOCObservation">
