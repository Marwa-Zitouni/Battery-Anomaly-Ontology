    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#TemporalEntity"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/phenomenonTime"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#phenomenonTimeOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#MarginalFuseRating">
