    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#Geometry"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasConfidence">
