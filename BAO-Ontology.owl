<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:cc="http://creativecommons.org/ns#"
   xmlns:dc="http://purl.org/dc/elements/1.1/"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:xhv="http://www.w3.org/1999/xhtml/vocab#"
>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#FuseFailureToBlow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">FuseFailureToBlow</rdfs:label>
    <rdfs:comment xml:lang="en">Fuse does not open under overcurrent when it should.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#PreChargeResistorShortCircuit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">PreChargeResistorShortCircuit</rdfs:label>
    <rdfs:comment xml:lang="en">Precharge resistor shorted, allowing inrush surge.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Geometry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdfs:label xml:lang="en">Geometry</rdfs:label>
    <rdfs:comment xml:lang="en">A geometry describing the spatial extent or position of a feature, aligned with GeoSPARQL.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#usesAlgorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">uses algorithm</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a detection event to the algorithm or model executed.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionEvent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionAlgorithm"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#algorithmUsedIn"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasChargeRate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">charge rate</rdfs:label>
    <rdfs:comment xml:lang="en">Charge or discharge rate notation (e.g., 1C, 2C, C/3).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#BatteryLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SpatialFeature"/>
    <rdfs:label xml:lang="en">BatteryLocation</rdfs:label>
    <rdfs:comment xml:lang="en">Spatial feature identifying a battery pack physical installation location.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CellLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SpatialFeature"/>
    <rdfs:label xml:lang="en">CellLocation</rdfs:label>
    <rdfs:comment xml:lang="en">Spatial feature identifying an individual cell position within a pack.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#containsCell">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">contains cell</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a battery pack to the cells it contains.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryPack"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryCell"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasDirectPart"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#containedInPack"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#performedDetectionEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">performed detection event</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a detection system to detection events for which it was responsible.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionSystem"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionEvent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#performedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">has part</rdfs:label>
    <rdfs:comment xml:lang="en">Transitive parthood between battery components. Assert immediate composition with hasDirectPart.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <rdfs:seeAlso rdf:resource="https://emmo-repo.github.io/domain-electrochemistry/userguide/background/emmo/emmo_wholes_and_parts.html"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#isPartOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SeparatorEmbrittlement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#AgingCause"/>
    <rdfs:label xml:lang="en">SeparatorEmbrittlement</rdfs:label>
    <rdfs:comment xml:lang="en">Loss of separator mechanical ductility due to aging, raising internal short risk.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#AbnormalSelfDischarge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">AbnormalSelfDischarge</rdfs:label>
    <rdfs:comment xml:lang="en">Cell self-discharge rate significantly higher than specified.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#GasEvolution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectrochemicalCause"/>
    <rdfs:label xml:lang="en">GasEvolution</rdfs:label>
    <rdfs:comment xml:lang="en">Generation of gaseous species from side reactions, causing swelling and pressure rise.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CurrentSensorGainFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">CurrentSensorGainFault</rdfs:label>
    <rdfs:comment xml:lang="en">Current sensor gain coefficient incorrect.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">condition</rdfs:label>
    <rdfs:comment xml:lang="en">Experimental or operational condition label (normal, overheating, tape_anomaly, ...).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">ModuleBattINFO</rdfs:label>
    <rdfs:comment xml:lang="en">Module 0 (BattINFO-aligned). Groups classes describing physical battery components: packs, cells, current collectors, BMS, safety hardware.</rdfs:comment>
    <rdfs:comment xml:lang="en">Organizational module marker used for ontology structuring; BAO modules are not an exclusive partition and may overlap.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleTime"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleAnomaly"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CapacityFade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">CapacityFade</rdfs:label>
    <rdfs:comment xml:lang="en">Loss of usable capacity vs initial BOL capacity exceeding expected rate.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ModuleProv">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">ModuleProv</rdfs:label>
    <rdfs:comment xml:lang="en">Module 5 (PROV-O aligned). Groups provenance entities: detection systems, algorithms, diagnostic reports, confidence.</rdfs:comment>
    <rdfs:comment xml:lang="en">Organizational module marker used for ontology structuring; BAO modules are not an exclusive partition and may overlap.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleTime"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleAnomaly"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="http://www.battery-ontology.org/liBatteryFault/3.3.0"/>
    <owl:priorVersion rdf:resource="http://www.battery-ontology.org/liBatteryFault/3.2.0"/>
    <owl:versionInfo>3.3.0</owl:versionInfo>
    <dcterms:title xml:lang="en">Battery Anomaly Ontology (BAO)</dcterms:title>
    <rdfs:label xml:lang="en">Battery Anomaly Ontology (BAO) v3.3</rdfs:label>
    <dcterms:description xml:lang="en">Ontology for Li-ion battery anomaly and fault diagnosis. It represents battery components, observations and evidence, temporal and spatial context, direct and indirect causes, imaging artefacts, diagnostic events, confidence, and provenance. BAO 3.3 references selected BattINFO/EMMO, SOSA/SSN, OWL-Time, GeoSPARQL, PROV-O, and QUDT terms through formal subclass and subproperty alignments without importing their complete axiom sets.</dcterms:description>
    <rdfs:comment xml:lang="en">BAO v3.3 implements the property-semantic audit: typed battery components and parthood, direct versus transitive causation, explicit competency-question paths, standards alignments, and corrected provenance, sensing, temporal, and spatial semantics.</rdfs:comment>
    <dcterms:creator>Marwa Zitouni</dcterms:creator>
    <dcterms:contributor>BAO Working Group</dcterms:contributor>
    <dcterms:publisher>Ecole Nationale Polytechnique (ENP), Algiers</dcterms:publisher>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-24</dcterms:issued>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-03</dcterms:modified>
    <dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
    <cc:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
    <xhv:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
    <dc:rights>Licensed under Creative Commons Attribution 4.0 International (CC-BY 4.0). See http://creativecommons.org/licenses/by/4.0/</dc:rights>
    <dcterms:rights xml:lang="en">Copyright 2026 BAO Working Group. Licensed under CC-BY 4.0.</dcterms:rights>
    <dc:rightsHolder>BAO Working Group</dc:rightsHolder>
    <dcterms:subject xml:lang="en">Lithium-ion batteries; fault diagnosis; anomaly detection; battery management system</dcterms:subject>
    <rdfs:seeAlso rdf:resource="https://big-map.github.io/BattINFO/ontology.html"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/vocab-ssn/"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/owl-time/"/>
    <rdfs:seeAlso rdf:resource="https://www.ogc.org/standard/geosparql/"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/prov-o/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CausalPhenomenon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleAnomaly"/>
    <rdfs:label xml:lang="en">CausalPhenomenon</rdfs:label>
    <rdfs:comment xml:lang="en">A diagnostically relevant condition, event, or mechanism that can participate as a cause or effect in a causal sequence.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#DetectionAlgorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#DiagnosticEntity"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Plan"/>
    <rdfs:label xml:lang="en">DetectionAlgorithm</rdfs:label>
    <rdfs:comment xml:lang="en">Algorithm or model used to detect anomalies (rule-based, ML classifier, physics model).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N29ed2a6d006f4375925e88800c7dfb09">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#SOCObservation"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SafetyComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:label xml:lang="en">SafetyComponent</rdfs:label>
    <rdfs:comment xml:lang="en">Passive safety element integrated into the cell or pack (vent, CID, PTC, burst disc).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#PreChargeRelayStuckClosed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">PreChargeRelayStuckClosed</rdfs:label>
    <rdfs:comment xml:lang="en">Precharge relay welded closed, bypassing the precharge resistor.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">ModuleSOSA</rdfs:label>
    <rdfs:comment xml:lang="en">Module 1 (SOSA/SSN-aligned). Groups sensor, observation, and measurement classes used to monitor battery state.</rdfs:comment>
    <rdfs:comment xml:lang="en">Organizational module marker used for ontology structuring; BAO modules are not an exclusive partition and may overlap.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleTime"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleAnomaly"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ModuleTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">ModuleTime</rdfs:label>
    <rdfs:comment xml:lang="en">Module 2 (OWL-Time aligned). Groups temporal primitives: onsets, durations, recovery times, temporal patterns.</rdfs:comment>
    <rdfs:comment xml:lang="en">Organizational module marker used for ontology structuring; BAO modules are not an exclusive partition and may overlap.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleAnomaly"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#isAdjacentTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:label xml:lang="en">is adjacent to</rdfs:label>
    <rdfs:comment xml:lang="en">Undirected physical adjacency between distinct battery components. It is intentionally non-transitive.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#isAdjacentTo"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasAnomalyDuration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has anomaly duration</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an Anomaly occurrence to the proper time interval during which it is active. The legacy name is retained for manuscript and ABox compatibility.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#AnomalyDuration"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasTime"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasAnomalyInterval"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#durationOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Detectability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleAnomaly"/>
    <rdfs:label xml:lang="en">Detectability</rdfs:label>
    <rdfs:comment xml:lang="en">Qualitative detectability of an anomaly (Low, Medium, High).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ContactorCoilDegradation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">ContactorCoilDegradation</rdfs:label>
    <rdfs:comment xml:lang="en">Contactor coil resistance drift or insulation degradation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasStdDev">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">std deviation</rdfs:label>
    <rdfs:comment xml:lang="en">Standard deviation of observed values in a time series.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#AnodeDegradation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectrochemicalCause"/>
    <rdfs:label xml:lang="en">AnodeDegradation</rdfs:label>
    <rdfs:comment xml:lang="en">Electrochemical degradation of anode active material (graphite exfoliation, SEI breakdown, loss of active Li sites).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#VoltageSensorBias">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">VoltageSensorBias</rdfs:label>
    <rdfs:comment xml:lang="en">Constant offset on the voltage channel.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#formFactorOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">form factor of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a form factor to the cells having it (inverse of hasFormFactor).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#CellFormFactor"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryCell"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasFormFactor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasFeatureOfInterest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has feature of interest</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an observation to the battery component whose property was observed.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/hasFeatureOfInterest"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#isFeatureOfInterestOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CalibrationError">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">CalibrationError</rdfs:label>
    <rdfs:comment xml:lang="en">Persistent calibration offset in a sensor channel.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf71a953de0f24ba39a4aeeb6a8bde69b">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="Neaf46dd55bfb4ed8913a7e89c5f7181d"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#AnodeCathodeShort">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">AnodeCathodeShort</rdfs:label>
    <rdfs:comment xml:lang="en">Direct internal short between anode and cathode through a compromised separator.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#affectsBatteryComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">affects battery component</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an Anomaly to the battery component it affects.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#affectedByAnomaly"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ContactorFailureToClose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">ContactorFailureToClose</rdfs:label>
    <rdfs:comment xml:lang="en">Contactor fails to close on command, disconnecting the pack.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#VoltageSpike">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">VoltageSpike</rdfs:label>
    <rdfs:comment xml:lang="en">Transient voltage excursion above nominal.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#durationOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">duration of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a duration to the Anomaly it quantifies (inverse of hasAnomalyDuration).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#AnomalyDuration"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#intervalOfAnomaly"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasAnomalyDuration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#FirmwareBug">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SoftwareCause"/>
    <rdfs:label xml:lang="en">FirmwareBug</rdfs:label>
    <rdfs:comment xml:lang="en">Firmware defect producing incorrect fault response or state estimation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasConfidenceScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">confidence score</rdfs:label>
    <rdfs:comment xml:lang="en">Confidence score between 0 and 1.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Confidence"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SoftwareCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Cause"/>
    <rdfs:label xml:lang="en">SoftwareCause</rdfs:label>
    <rdfs:comment xml:lang="en">Root cause category: firmware/control software faults (firmware bugs, control-loop instability, protocol mismatch, stack overflow).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Puncture">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#MechanicalCause"/>
    <rdfs:label xml:lang="en">Puncture</rdfs:label>
    <rdfs:comment xml:lang="en">Partial penetration of the cell casing, risking localized internal short.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#VoltageSensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Sensor"/>
    <rdfs:label xml:lang="en">VoltageSensor</rdfs:label>
    <rdfs:comment xml:lang="en">Sensor producing voltage observations.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#imageOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">image of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an image to the component it depicts (inverse of hasImage).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Image"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasImage"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#DiagnosticReport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#DiagnosticEntity"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">DiagnosticReport</rdfs:label>
    <rdfs:comment xml:lang="en">Structured report aggregating detection events, causes, affected components, and confidence.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ContactorIntermittentContact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">ContactorIntermittentContact</rdfs:label>
    <rdfs:comment xml:lang="en">Contactor exhibits bouncing or intermittent conduction under load.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasAnomalyEnd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has anomaly end</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an anomaly occurrence to its end instant; aligned as a subproperty of time:hasEnd.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#TimeInstant"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasEnd"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#endOfAnomaly"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#segmentationOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">segmentation of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a segmentation mask to its source image (inverse of hasSegmentation).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#SegmentationMask"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Image"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasSegmentation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasMeasurementUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has measurement unit</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a quantity value to its explicit measurement unit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#QuantityValue"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#MeasurementUnit"/>
    <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/unit"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#unitOfQuantityValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">has unit</rdfs:label>
    <rdfs:comment xml:lang="en">Deprecated legacy string unit retained for manuscript and ABox compatibility. New data should use hasObservationResult with QuantityValue and hasMeasurementUnit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Timestamp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:label xml:lang="en">Timestamp</rdfs:label>
    <rdfs:comment xml:lang="en">Provenance timestamp marking when a DetectionEvent or report was produced (xsd:dateTime).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#MultiCellThermalPropagation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">MultiCellThermalPropagation</rdfs:label>
    <rdfs:comment xml:lang="en">Thermal runaway propagating from one cell to neighboring cells.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#PorousSeparator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ManufacturingCause"/>
    <rdfs:label xml:lang="en">PorousSeparator</rdfs:label>
    <rdfs:comment xml:lang="en">Separator porosity out of specification, weakening its shorting barrier.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SeparatorDissolution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectrochemicalCause"/>
    <rdfs:label xml:lang="en">SeparatorDissolution</rdfs:label>
    <rdfs:comment xml:lang="en">Chemical dissolution or thinning of the polymer separator by electrolyte side reactions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#TemperatureMap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:label xml:lang="en">TemperatureMap</rdfs:label>
    <rdfs:comment xml:lang="en">Pixel-level temperature map (thermal image treated as a measurement field).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#anomalyOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">anomaly of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an Anomaly to the battery component it belongs to (inverse of hasAnomaly).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#affectsBatteryComponent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasAnomaly"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#LithiumPlating">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectrochemicalCause"/>
    <rdfs:label xml:lang="en">LithiumPlating</rdfs:label>
    <rdfs:comment xml:lang="en">Deposition of metallic lithium on the anode surface instead of intercalation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#relativeToExperiment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">relative to experiment</rdfs:label>
    <rdfs:comment xml:lang="en">Identifies the experiment that supplies the zero point for an elapsed temporal coordinate.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#TemporalEntity"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Experiment"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasRelativeTemporalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasCycleCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">cycle count</rdfs:label>
    <rdfs:comment xml:lang="en">Number of charge/discharge cycles accumulated.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#DetectionSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#DiagnosticEntity"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:label xml:lang="en">DetectionSystem</rdfs:label>
    <rdfs:comment xml:lang="en">Software or hardware system that runs DetectionAlgorithms on observations.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#generatedReport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">generated report</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a DetectionEvent to the reports it generated (inverse of generatedBy).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionEvent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#DiagnosticReport"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#generated"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#generatedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ThermalCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Cause"/>
    <rdfs:label xml:lang="en">ThermalCause</rdfs:label>
    <rdfs:comment xml:lang="en">Root cause category: thermal stressors (extreme heat/cold, thermal cycling, thermal shock, self-heating).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ModuleGeo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">ModuleGeo</rdfs:label>
    <rdfs:comment xml:lang="en">Module 3 (GeoSPARQL-aligned). Groups spatial primitives: battery locations, cell positions, hotspot regions, geometries.</rdfs:comment>
    <rdfs:comment xml:lang="en">Organizational module marker used for ontology structuring; BAO modules are not an exclusive partition and may overlap.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleTime"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleAnomaly"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hotspotOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hotspot of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a hotspot region to the Anomaly it evidences (inverse of hasHotspot).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#HotspotRegion"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#locationOf"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasHotspot"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#WaterContentExcess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ManufacturingCause"/>
    <rdfs:label xml:lang="en">WaterContentExcess</rdfs:label>
    <rdfs:comment xml:lang="en">Excess residual moisture in cell components from drying process.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#FuseDegradation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">FuseDegradation</rdfs:label>
    <rdfs:comment xml:lang="en">Fuse element resistance drift reducing its protective margin.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ThermoMechanicalFatigue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#MechanicalCause"/>
    <rdfs:label xml:lang="en">ThermoMechanicalFatigue</rdfs:label>
    <rdfs:comment xml:lang="en">Fatigue accelerated by combined thermal cycling and mechanical loading.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ImagingAnalysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">ImagingAnalysis</rdfs:label>
    <rdfs:comment xml:lang="en">Process or activity that analyses one or more images to produce AnalysisResults.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Confidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Confidence</rdfs:label>
    <rdfs:comment xml:lang="en">Confidence score attached to a detection event or diagnosis (real-valued in [0, 1]).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasRelativeTemporalEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <rdfs:label xml:lang="en">has relative temporal entity</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an experiment to temporal entities whose coordinates use its origin.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Experiment"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#TemporalEntity"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#relativeToExperiment"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CurrentObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:label xml:lang="en">CurrentObservation</rdfs:label>
    <rdfs:comment xml:lang="en">Observation instance whose observed property is electrical current (A).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has value</rdfs:label>
    <rdfs:comment xml:lang="en">Numeric value of an observation or measurement.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/hasSimpleResult"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#isFeatureOfInterestOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is feature of interest of</rdfs:label>
