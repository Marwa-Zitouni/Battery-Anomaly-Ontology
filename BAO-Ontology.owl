  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#TemperatureSensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Sensor"/>
    <rdfs:label xml:lang="en">TemperatureSensor</rdfs:label>
    <rdfs:comment xml:lang="en">Sensor producing temperature observations.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ObservableProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Property"/>
    <rdfs:label xml:lang="en">ObservableProperty</rdfs:label>
    <rdfs:comment xml:lang="en">Local class mirroring the SOSA concept of an observable physical quantity (voltage, current, temperature, SOC).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasSeverityLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
