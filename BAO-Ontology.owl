  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ProtocolMismatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SoftwareCause"/>
    <rdfs:label xml:lang="en">ProtocolMismatch</rdfs:label>
    <rdfs:comment xml:lang="en">Communication protocol mismatch between BMS and charger or vehicle controller.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#TemperatureObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:label xml:lang="en">TemperatureObservation</rdfs:label>
    <rdfs:comment xml:lang="en">Observation instance whose observed property is temperature (degrees Celsius).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#DeepDischarge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#OperationalCause"/>
    <rdfs:label xml:lang="en">DeepDischarge</rdfs:label>
    <rdfs:comment xml:lang="en">Discharge below the safe minimum SOC or voltage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ElectrolyteDecomposition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectrochemicalCause"/>
    <rdfs:label xml:lang="en">ElectrolyteDecomposition</rdfs:label>
    <rdfs:comment xml:lang="en">Oxidative or reductive decomposition of electrolyte producing gas and resistive films.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6a3e6941d998436fa947998ed4ae2251">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#EnvironmentalCause"/>
    <rdf:rest rdf:nodeID="N7d36e3eee6314d2bbae629a0f46521ba"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#RelayFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">RelayFailure</rdfs:label>
    <rdfs:comment xml:lang="en">General auxiliary relay failure.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ImagingMetadata">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:label xml:lang="en">ImagingMetadata</rdfs:label>
    <rdfs:comment xml:lang="en">Metadata describing an image (resolution, modality, acquisition parameters, device).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasAnomaly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has anomaly</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a battery component to a detected Anomaly it exhibits.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#affectedByAnomaly"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#anomalyOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#MonolithicCathodeBlockingLayerGrowth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#AgingCause"/>
    <rdfs:label xml:lang="en">MonolithicCathodeBlockingLayerGrowth</rdfs:label>
    <rdfs:comment xml:lang="en">Growth of resistive interphase layers at the cathode over time, blocking Li-ion transport.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4b38d24117f341ae807b1fe6067d0ca6">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#VoltageSensor"/>
    <rdf:rest rdf:nodeID="Ne25a895e18d44a9cba9a01d8592651d4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#HeaterFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">HeaterFault</rdfs:label>
    <rdfs:comment xml:lang="en">Pack heater stuck-on, stuck-off, or providing wrong power.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#RecoveryTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleTime"/>
    <rdfs:label xml:lang="en">RecoveryTime</rdfs:label>
    <rdfs:comment xml:lang="en">Duration between anomaly onset and recovery or clearance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Cause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleAnomaly"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#CausalPhenomenon"/>
    <rdfs:label xml:lang="en">Cause</rdfs:label>
    <rdfs:comment xml:lang="en">Top-level root cause: an underlying condition that explains one or more observed anomalies.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#FuseFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">FuseFailure</rdfs:label>
    <rdfs:comment xml:lang="en">Generic fuse fault (open, degraded, or non-functional).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#intervalOfAnomaly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">interval of anomaly</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an active interval to the anomaly occurrence it temporally bounds.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#AnomalyDuration"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasAnomalyInterval"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CurrentCollector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:label xml:lang="en">CurrentCollector</rdfs:label>
    <rdfs:comment xml:lang="en">Conductive metallic foil collecting electrons from the active material of either electrode.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ContactorWeldedContacts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">ContactorWeldedContacts</rdfs:label>
    <rdfs:comment xml:lang="en">Contactor contacts welded shut, unable to open.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#RepeatAbuseChargingCycles">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#OperationalCause"/>
    <rdfs:label xml:lang="en">RepeatAbuseChargingCycles</rdfs:label>
    <rdfs:comment xml:lang="en">Repeated charging beyond the safe CV envelope.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#PassiveBalancingMOSFETStuckOff">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">PassiveBalancingMOSFETStuckOff</rdfs:label>
    <rdfs:comment xml:lang="en">Passive-balancing switch MOSFET stuck open; cell cannot be bled.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#AnalysisResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">AnalysisResult</rdfs:label>
    <rdfs:comment xml:lang="en">Output of an imaging-based analysis pipeline (segmentation, classification, anomaly score).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
