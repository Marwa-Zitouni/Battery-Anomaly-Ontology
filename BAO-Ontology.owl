    <rdfs:label xml:lang="en">min voltage (V)</rdfs:label>
    <rdfs:comment xml:lang="en">Minimum allowed operating voltage in volts.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CompoundingAging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#AgingCause"/>
    <rdfs:label xml:lang="en">CompoundingAging</rdfs:label>
    <rdfs:comment xml:lang="en">Combined effect of multiple overlapping aging mechanisms accelerating total degradation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#RepeatedOverchargeDischarge">
