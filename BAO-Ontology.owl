  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SEILayerGrowth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">SEILayerGrowth</rdfs:label>
    <rdfs:comment xml:lang="en">Excessive growth of the solid-electrolyte interphase consuming cyclable lithium.</rdfs:comment>
