    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">SoftInternalShortCircuit</rdfs:label>
    <rdfs:comment xml:lang="en">High-resistance internal short producing slow voltage drift.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasFormFactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has form factor</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a cell to its physical form factor.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryCell"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#CellFormFactor"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#formFactorOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#generatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">generated by</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a DiagnosticReport to the DetectionEvent that generated it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#DiagnosticReport"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionEvent"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#generatedReport"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Fatigue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#MechanicalCause"/>
    <rdfs:label xml:lang="en">Fatigue</rdfs:label>
    <rdfs:comment xml:lang="en">Cyclic mechanical loading causing progressive crack growth in structural parts.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasTimestamp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">elapsed time coordinate (s)</rdfs:label>
    <rdfs:comment xml:lang="en">Elapsed-time coordinate in seconds from the origin of the experiment linked by relativeToExperiment. This is not an absolute timestamp.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#TimeInstant"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Polygon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Geometry"/>
    <rdfs:label xml:lang="en">Polygon</rdfs:label>
    <rdfs:comment xml:lang="en">Geometric polygon primitive used for hotspot or defect region outlines.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#MeasurementUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    <rdfs:label xml:lang="en">MeasurementUnit</rdfs:label>
    <rdfs:comment xml:lang="en">Physical unit of measurement associated with observation values (V, A, degC, Ohm, etc.).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CathodeDegradation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectrochemicalCause"/>
    <rdfs:label xml:lang="en">CathodeDegradation</rdfs:label>
    <rdfs:comment xml:lang="en">Electrochemical degradation of cathode active material (transition-metal dissolution, oxygen release).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CoatingDefects">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ManufacturingCause"/>
    <rdfs:label xml:lang="en">CoatingDefects</rdfs:label>
    <rdfs:comment xml:lang="en">Electrode coating non-uniformities (pinholes, thickness variation) causing local current concentration.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#InsulationMonitoringDeviceFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">InsulationMonitoringDeviceFault</rdfs:label>
    <rdfs:comment xml:lang="en">Insulation-monitoring device malfunction failing to detect ground faults.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#causeOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">cause of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a causal phenomenon to its direct or indirect effects; inverse of the transitive hasCause relation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#CausalPhenomenon"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#CausalPhenomenon"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasCause"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ModuleImaging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">ModuleImaging</rdfs:label>
    <rdfs:comment xml:lang="en">Module 4 (imaging data). Groups imaging artefacts: thermal/visual images, segmentation masks, analysis results.</rdfs:comment>
    <rdfs:comment xml:lang="en">Organizational module marker used for ontology structuring; BAO modules are not an exclusive partition and may overlap.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleTime"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleAnomaly"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#StatisticalSummary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ObservationResult"/>
    <rdfs:label xml:lang="en">StatisticalSummary</rdfs:label>
    <rdfs:comment xml:lang="en">A result containing statistics for a defined observation window, property, unit, and aggregation procedure.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Point">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Geometry"/>
    <rdfs:label xml:lang="en">Point</rdfs:label>
    <rdfs:comment xml:lang="en">Geometric point primitive used for hotspot centroids and sensor locations.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#geometryOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">geometry of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a geometry to the spatial features it represents.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Geometry"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#SpatialFeature"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasGeometry"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#wasDetectedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">was detected in</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an anomaly assertion to the detection event that produced it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionEvent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#detectedAnomaly"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc479a10472164a06968f9b2be15e5f36">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#performedBy"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#FuseBlowFalseTrip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">FuseBlowFalseTrip</rdfs:label>
    <rdfs:comment xml:lang="en">Fuse blows below its rated current (nuisance trip).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#GasSmokeSensorFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">GasSmokeSensorFault</rdfs:label>
    <rdfs:comment xml:lang="en">Gas or smoke detector fails to report venting or produces false alarms.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#IncorrectParameterConfiguration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SoftwareCause"/>
    <rdfs:label xml:lang="en">IncorrectParameterConfiguration</rdfs:label>
    <rdfs:comment xml:lang="en">Miscalibrated BMS thresholds (OCV table, temperature cutoffs, SOC bounds).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CycleLifeExhaustion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">CycleLifeExhaustion</rdfs:label>
    <rdfs:comment xml:lang="en">Cell has exceeded its rated cycle count and entered end-of-life regime.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#OnsetTimestamp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleTime"/>
    <rdfs:label xml:lang="en">OnsetTimestamp</rdfs:label>
    <rdfs:comment xml:lang="en">Concrete timestamp (xsd:dateTime) marking an anomaly onset.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasMaxValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">max value</rdfs:label>
    <rdfs:comment xml:lang="en">Maximum observed value in a time series.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasWidth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">width (px)</rdfs:label>
    <rdfs:comment xml:lang="en">Image width in pixels.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Image"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CommunicationFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">CommunicationFailure</rdfs:label>
    <rdfs:comment xml:lang="en">Sensor signal cannot be communicated to the BMS controller.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ConductiveDebrisContamination">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#EnvironmentalCause"/>
    <rdfs:label xml:lang="en">ConductiveDebrisContamination</rdfs:label>
    <rdfs:comment xml:lang="en">Ingress of conductive particles creating internal short paths.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasDirectCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:label xml:lang="en">has direct cause</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a causal phenomenon to an immediate cause. It is intentionally non-transitive.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#CausalPhenomenon"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#CausalPhenomenon"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasCause"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#directCauseOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SolidElectrolyteInterface">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:label xml:lang="en">SolidElectrolyteInterface</rdfs:label>
    <rdfs:comment xml:lang="en">Thin passivation layer formed on the anode surface by electrolyte reduction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ThermalImage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Image"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:label xml:lang="en">ThermalImage</rdfs:label>
    <rdfs:comment xml:lang="en">Image captured with a thermal (IR) sensor.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#sensorOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">sensor of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a sensor to the battery component it monitors (inverse of hasSensor).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Sensor"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasSensor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#PoorPackingGeometry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#DesignCause"/>
    <rdfs:label xml:lang="en">PoorPackingGeometry</rdfs:label>
    <rdfs:comment xml:lang="en">Design fault: mechanical packaging geometry concentrates stress or impedes cooling.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has evidence</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a diagnosed anomaly occurrence to an observation, image, or other evidence item supporting it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#DiagnosticEvidence"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#evidenceFor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SeverityLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleAnomaly"/>
    <rdfs:label xml:lang="en">SeverityLevel</rdfs:label>
    <rdfs:comment xml:lang="en">Qualitative severity level assigned to an anomaly (Low, Medium, High, Critical).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasMinValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">min value</rdfs:label>
    <rdfs:comment xml:lang="en">Minimum observed value in a time series.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ElectrolyteDegradation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">ElectrolyteDegradation</rdfs:label>
    <rdfs:comment xml:lang="en">Manifest electrolyte degradation diagnosable via impedance or voltage signatures.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#TemperatureSensorStuckFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">TemperatureSensorStuckFault</rdfs:label>
    <rdfs:comment xml:lang="en">Temperature sensor stuck at a constant value.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SensorSignalLoss">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">SensorSignalLoss</rdfs:label>
    <rdfs:comment xml:lang="en">Sensor signal intermittently drops to zero.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#madeBySensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">made by sensor</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an Observation to the Sensor that produced it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Sensor"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/madeBySensor"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#madeObservation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#LightningStrike">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectricalCause"/>
    <rdfs:label xml:lang="en">LightningStrike</rdfs:label>
    <rdfs:comment xml:lang="en">Lightning-induced surge coupling into pack wiring, damaging electronics or cells.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Pixel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:label xml:lang="en">Pixel</rdfs:label>
    <rdfs:comment xml:lang="en">Addressable picture element of an Image or SegmentationMask.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ElectromagneticInterference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectricalCause"/>
    <rdfs:label xml:lang="en">ElectromagneticInterference</rdfs:label>
    <rdfs:comment xml:lang="en">External EM interference corrupting sensor readings or BMS control signals.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SeparatorFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">SeparatorFailure</rdfs:label>
    <rdfs:comment xml:lang="en">Separator tearing, shrinkage, or dissolution leading to imminent short.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CEILayerGrowth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">CEILayerGrowth</rdfs:label>
    <rdfs:comment xml:lang="en">Excessive growth of the cathode electrolyte interphase raising impedance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasPeakTemperature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">peak temperature (C)</rdfs:label>
    <rdfs:comment xml:lang="en">Peak temperature reached during the anomaly in degrees Celsius.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasThreshold">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">threshold</rdfs:label>
    <rdfs:comment xml:lang="en">Threshold value used for anomaly detection.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionConfiguration"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CurrentSensorBias">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">CurrentSensorBias</rdfs:label>
    <rdfs:comment xml:lang="en">Constant offset on the current-sensor channel.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#OvercurrentStress">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#OperationalCause"/>
    <rdfs:label xml:lang="en">OvercurrentStress</rdfs:label>
    <rdfs:comment xml:lang="en">Operational profile repeatedly exceeding C-rate limits.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf8bbcf410e294656b5abdac8831dda17">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N58367d4f993d425eb1f0e2cf8e0ed7c7"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SensorNoiseAmplification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">SensorNoiseAmplification</rdfs:label>
    <rdfs:comment xml:lang="en">Sensor signal-to-noise ratio collapse.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nec9c3e02c30e4ebdbf07d043d792cb27">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#VisualImage"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#VisualImage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Image"/>
    <rdfs:label xml:lang="en">VisualImage</rdfs:label>
    <rdfs:comment xml:lang="en">Image captured with a visible-light sensor.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#AnodeParticleAgglomeration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#AgingCause"/>
    <rdfs:label xml:lang="en">AnodeParticleAgglomeration</rdfs:label>
    <rdfs:comment xml:lang="en">Aging-related agglomeration of anode active-material particles, increasing impedance and reducing accessible capacity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#DendriteFormation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">DendriteFormation</rdfs:label>
    <rdfs:comment xml:lang="en">Metallic lithium dendrites grow through the separator, risking hard short.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CurrentSpike">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">CurrentSpike</rdfs:label>
    <rdfs:comment xml:lang="en">Transient current excursion far above nominal.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#FanFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">FanFailure</rdfs:label>
    <rdfs:comment xml:lang="en">Air-cooling fan failure reducing convective cooling.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nab6c721a4d2f4f089745e51cd12e566b">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#MechanicalCause"/>
    <rdf:rest rdf:nodeID="N743ca7831e9c41178a355ae35b436ee5"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SensorSaturation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">SensorSaturation</rdfs:label>
    <rdfs:comment xml:lang="en">Sensor output pinned at its upper or lower rail.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Anomaly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleAnomaly"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#CausalPhenomenon"/>
    <rdfs:label xml:lang="en">Anomaly</rdfs:label>
    <rdfs:comment xml:lang="en">Top-level anomaly: any deviation from expected behaviour in the battery system that is diagnostically relevant.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CopperAluminumShort">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">CopperAluminumShort</rdfs:label>
    <rdfs:comment xml:lang="en">Short between copper (anode) and aluminum (cathode) current collectors.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ModuleAnomaly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="en">ModuleAnomaly</rdfs:label>
    <rdfs:comment xml:lang="en">Module 6 (core anomaly reasoning). Groups the top-level Anomaly and Cause taxonomies driving diagnostic inference.</rdfs:comment>
    <rdfs:comment xml:lang="en">Organizational module marker used for ontology structuring; BAO modules are not an exclusive partition and may overlap.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleTime"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:seeAlso rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CoatingDegradation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#AgingCause"/>
    <rdfs:label xml:lang="en">CoatingDegradation</rdfs:label>
    <rdfs:comment xml:lang="en">Gradual degradation of electrode coating due to cycling or calendar aging, increasing resistance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne1600f752f0d4036aa1235962c282f11">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#Cause"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N672dbdda96ce432ba8a7314e19131da7">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#DesignCause"/>
    <rdf:rest rdf:nodeID="N5f1cfbd4f2a64636a4e926a216f54a73"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#HumidityFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">HumidityFault</rdfs:label>
    <rdfs:comment xml:lang="en">Humidity sensor fault providing incorrect moisture readings.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasObservedProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has observed property</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an Observation to the property it observes.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#ObservableProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/observedProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#wasObservedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SpatialRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:label xml:lang="en">SpatialRelation</rdfs:label>
    <rdfs:comment xml:lang="en">Abstract spatial relation between two features (contains, intersects, near, above, below).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ADCDrift">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">ADCDrift</rdfs:label>
    <rdfs:comment xml:lang="en">Analog-to-digital converter reading drift over temperature or time.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#confidenceOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">confidence of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a confidence assessment to the detection event it qualifies.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Confidence"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionEvent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasConfidence"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#algorithmUsedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">algorithm used in</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an algorithm or model to detection events that executed it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionAlgorithm"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionEvent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#usesAlgorithm"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#triggeredByObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">triggered by observation</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a diagnostic anomaly assertion to the observation that triggered it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasEvidence"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#triggersAnomaly"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#FastChargingAtLowTemperature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectrochemicalCause"/>
    <rdfs:label xml:lang="en">FastChargingAtLowTemperature</rdfs:label>
    <rdfs:comment xml:lang="en">High-rate charging below about 10 degrees Celsius, promoting lithium plating.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#madeObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">made observation</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a Sensor to the Observations it produced (inverse of madeBySensor).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Sensor"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/madeObservation"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#madeBySensor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#StrainInducedFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#MechanicalCause"/>
    <rdfs:label xml:lang="en">StrainInducedFailure</rdfs:label>
    <rdfs:comment xml:lang="en">Failure under sustained mechanical strain outside the elastic regime.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasObservationResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has observation result</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an Observation to its Result.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#ObservationResult"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/hasResult"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#isResultOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CompressionDamage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#MechanicalCause"/>
    <rdfs:label xml:lang="en">CompressionDamage</rdfs:label>
    <rdfs:comment xml:lang="en">Excessive compressive load deforming the cell stack.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7d36e3eee6314d2bbae629a0f46521ba">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#ManufacturingCause"/>
    <rdf:rest rdf:nodeID="Nab6c721a4d2f4f089745e51cd12e566b"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CopperCathodeShort">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">CopperCathodeShort</rdfs:label>
    <rdfs:comment xml:lang="en">Short between copper current collector and cathode active material.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#usesConfiguration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">uses configuration</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a detection event to the versioned threshold and parameter configuration it used.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionEvent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionConfiguration"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#configurationUsedIn"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Actuator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:label xml:lang="en">Actuator</rdfs:label>
    <rdfs:comment xml:lang="en">A physical control or protection component that performs an action affecting the battery system.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#QuantityValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ObservationResult"/>
    <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
    <rdfs:label xml:lang="en">QuantityValue</rdfs:label>
    <rdfs:comment xml:lang="en">A numerical observation result associated with an explicit unit, aligned with QUDT QuantityValue.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#MechanicalCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Cause"/>
    <rdfs:label xml:lang="en">MechanicalCause</rdfs:label>
    <rdfs:comment xml:lang="en">Root cause category: mechanical loading (impact, puncture, compression, fatigue, thermo-mechanical fatigue, nail penetration).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasCellPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">cell position</rdfs:label>
    <rdfs:comment xml:lang="en">Position identifier of a cell in the pack (e.g., row/column index or pack slot).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#CellLocation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ElectricalCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Cause"/>
    <rdfs:label xml:lang="en">ElectricalCause</rdfs:label>
    <rdfs:comment xml:lang="en">Root cause category: electrical stressors external to the cell (EMI, lightning, overcurrent/overvoltage events).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#VoltageObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:label xml:lang="en">VoltageObservation</rdfs:label>
    <rdfs:comment xml:lang="en">Observation instance whose observed property is voltage (V).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasSamplingInterval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">sampling interval (s)</rdfs:label>
    <rdfs:comment xml:lang="en">Sampling interval of the observation series in seconds.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ActiveBalancingCircuitFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">ActiveBalancingCircuitFailure</rdfs:label>
    <rdfs:comment xml:lang="en">Failure of the active balancing circuit (e.g., DC-DC converter stage) unable to transfer charge between cells.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N95ad251f9615478690a777da6bb871db">
