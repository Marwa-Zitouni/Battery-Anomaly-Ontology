    <rdfs:label xml:lang="en">phenomenon time of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a temporal entity to observations applying at that time.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#TemporalEntity"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
