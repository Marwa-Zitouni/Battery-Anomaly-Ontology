    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SoftInternalShortCircuit">
