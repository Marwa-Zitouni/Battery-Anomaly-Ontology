    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:label xml:lang="en">SOCObservation</rdfs:label>
    <rdfs:comment xml:lang="en">Observation of State-of-Charge (fraction or percentage).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#DeepDischargeCharge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectrochemicalCause"/>
    <rdfs:label xml:lang="en">DeepDischargeCharge</rdfs:label>
    <rdfs:comment xml:lang="en">Repeated full-depth discharge/charge cycling exacerbating electrochemical stress.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CurrentSensorCompleteFailure">
