    <rdfs:label xml:lang="en">HotspotDetection</rdfs:label>
    <rdfs:comment xml:lang="en">Imaging analysis result flagging one or more hotspot regions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ElectrolyteDegradationOverTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#AgingCause"/>
    <rdfs:label xml:lang="en">ElectrolyteDegradationOverTime</rdfs:label>
