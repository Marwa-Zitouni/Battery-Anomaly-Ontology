  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ElectricalInterface">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:label xml:lang="en">ElectricalInterface</rdfs:label>
    <rdfs:comment xml:lang="en">Physical electrical interface of a battery cell, module, or pack. Generalizes Terminal and Connector without merging them.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasDetectability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has detectability</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an Anomaly to its qualitative detectability.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Detectability"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#detectabilityOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#BatteryChemistry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:label xml:lang="en">BatteryChemistry</rdfs:label>
    <rdfs:comment xml:lang="en">Active-material chemistry of a Li-ion cell (NMC, LFP, NCA, LTO, LCO, etc.).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#AgingCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Cause"/>
    <rdfs:label xml:lang="en">AgingCause</rdfs:label>
    <rdfs:comment xml:lang="en">Root cause category: degradation mechanisms that accrue with calendar or cycle age (SEI growth, phase change, exfoliation, etc.).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#PassiveBalancingMOSFETStuckOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">PassiveBalancingMOSFETStuckOn</rdfs:label>
    <rdfs:comment xml:lang="en">Passive-balancing switch MOSFET stuck closed; cell is continuously bled.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#HotspotRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SpatialFeature"/>
    <rdfs:label xml:lang="en">HotspotRegion</rdfs:label>
    <rdfs:comment xml:lang="en">Spatial region in an image or pack volume exhibiting abnormally high temperature.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#MoistureIngress">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#EnvironmentalCause"/>
    <rdfs:label xml:lang="en">MoistureIngress</rdfs:label>
    <rdfs:comment xml:lang="en">Water vapour penetrating the cell, reacting with Li salts to produce HF.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#AssemblyMisalignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ManufacturingCause"/>
    <rdfs:label xml:lang="en">AssemblyMisalignment</rdfs:label>
    <rdfs:comment xml:lang="en">Electrode stack or jelly-roll misalignment during assembly, risking internal contact.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasSegmentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <rdfs:label xml:lang="en">has segmentation</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an image to its segmentation mask.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Image"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#SegmentationMask"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#segmentationOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SegmentationMask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">SegmentationMask</rdfs:label>
    <rdfs:comment xml:lang="en">Binary or multi-class pixel mask identifying regions of interest in an image.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#phenomenonTimeOf">
