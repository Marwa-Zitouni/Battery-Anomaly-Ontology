  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#InsufficientBMSProtection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#DesignCause"/>
    <rdfs:label xml:lang="en">InsufficientBMSProtection</rdfs:label>
    <rdfs:comment xml:lang="en">Design fault: BMS thresholds or fault responses are too permissive for the cell chemistry.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#VoltageSag">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">VoltageSag</rdfs:label>
    <rdfs:comment xml:lang="en">Sustained voltage drop under load beyond expected IR drop.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#wasObservedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">was observed by</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an ObservableProperty to the Observations of it; inverse of hasObservedProperty and aligned with sosa:wasObservedBy.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#ObservableProperty"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/wasObservedBy"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasObservedProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#containedInPack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">contained in pack</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a cell to the pack that contains it (inverse of containsCell).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryCell"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#isDirectPartOf"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryPack"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#containsCell"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ContactorFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">ContactorFailure</rdfs:label>
    <rdfs:comment xml:lang="en">Generic contactor failure affecting pack connection.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#detectabilityOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">detectability of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a Detectability to the Anomaly it qualifies (inverse of hasDetectability).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Detectability"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasDetectability"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Image">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#DiagnosticEvidence"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Image</rdfs:label>
    <rdfs:comment xml:lang="en">Digital image (thermal or visual) captured of a battery component.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#providesContextFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">provides context for</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a contextual observation to an anomaly occurrence.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasContextObservation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ElectrochemicalCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Cause"/>
    <rdfs:label xml:lang="en">ElectrochemicalCause</rdfs:label>
    <rdfs:comment xml:lang="en">Root cause category: electrochemical degradation inside the cell (lithium plating, electrolyte decomposition, anode/cathode degradation).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#involvesActuator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">involves actuator</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an anomaly occurrence, including an actuator fault, to the physical actuator involved.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Actuator"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#involvedInAnomaly"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#coOccursWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:label xml:lang="en">co-occurs with</rdfs:label>
    <rdfs:comment xml:lang="en">A symmetric, non-transitive relation between distinct anomaly occurrences whose temporal extents overlap.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#coOccursWith"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasSpatialPosition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has spatial position</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a hotspot region to a pixel-coordinate individual in a specified image frame.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#HotspotRegion"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#PixelCoordinate"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/spatial"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#positionsHotspot"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#InsufficientInterCellSpacing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#DesignCause"/>
    <rdfs:label xml:lang="en">InsufficientInterCellSpacing</rdfs:label>
    <rdfs:comment xml:lang="en">Design fault: gaps between cells too small, enabling thermal propagation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#configurationUsedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">configuration used in</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a detection configuration to events that used it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionConfiguration"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionEvent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#usesConfiguration"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#BalancingResistorFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">BalancingResistorFailure</rdfs:label>
    <rdfs:comment xml:lang="en">Passive-balancing bleed resistor open or short.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasContextObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has context observation</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an anomaly occurrence to an observation describing ambient or operating conditions at its time.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasEvidence"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#providesContextFor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ImpactDamage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#MechanicalCause"/>
    <rdfs:label xml:lang="en">ImpactDamage</rdfs:label>
    <rdfs:comment xml:lang="en">Blunt or sharp impact damage to the cell casing or internals.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ThermalManagementFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">ThermalManagementFailure</rdfs:label>
    <rdfs:comment xml:lang="en">Overall thermal-management subsystem failure (cooling or heating inadequate).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ContactorFailureToOpen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">ContactorFailureToOpen</rdfs:label>
    <rdfs:comment xml:lang="en">Contactor fails to open on command, preventing safe isolation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ObservationResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Result"/>
    <rdfs:label xml:lang="en">ObservationResult</rdfs:label>
    <rdfs:comment xml:lang="en">Local class mirroring the SOSA concept of the value produced by an Observation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#VoltageImbalance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">VoltageImbalance</rdfs:label>
    <rdfs:comment xml:lang="en">Cell-to-cell voltage spread within a module exceeds threshold.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#isResultOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <rdfs:label xml:lang="en">is result of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a Result to the Observation it belongs to (inverse of hasObservationResult).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#ObservationResult"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/isResultOf"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasObservationResult"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#PressureSensorFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">PressureSensorFault</rdfs:label>
    <rdfs:comment xml:lang="en">Internal-pressure sensor fault preventing venting detection.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#DetectionEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">DetectionEvent</rdfs:label>
    <rdfs:comment xml:lang="en">Provenance event: an execution of a DetectionAlgorithm producing one or more anomaly findings.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#InsufficientAnodeCathodeCapacityRatio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#DesignCause"/>
    <rdfs:label xml:lang="en">InsufficientAnodeCathodeCapacityRatio</rdfs:label>
    <rdfs:comment xml:lang="en">Design fault: N/P ratio too low, promoting lithium plating on charge.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#AnodeOverLithiation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">AnodeOverLithiation</rdfs:label>
    <rdfs:comment xml:lang="en">Lithium inventory at the anode exceeds safe stoichiometric limits, promoting plating.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ThermalSpike">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">ThermalSpike</rdfs:label>
    <rdfs:comment xml:lang="en">Transient local temperature excursion above threshold.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#BatteryCell">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:label xml:lang="en">BatteryCell</rdfs:label>
    <rdfs:comment xml:lang="en">An individual electrochemical cell in a battery module or pack.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <rdfs:seeAlso rdf:resource="https://big-map.github.io/BattINFO/ontology.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#isPartOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">is part of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse transitive parthood from a component to an enclosing component.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasPart"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4a3bdd08a134465fbbfd6e2e079439b8">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#ThermalImage"/>
    <rdf:rest rdf:nodeID="Nec9c3e02c30e4ebdbf07d043d792cb27"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasMaxVoltage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">max voltage (V)</rdfs:label>
    <rdfs:comment xml:lang="en">Maximum allowed operating voltage in volts.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#EnvironmentalCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Cause"/>
    <rdfs:label xml:lang="en">EnvironmentalCause</rdfs:label>
    <rdfs:comment xml:lang="en">Root cause category: environmental ingress and contamination (moisture, dust, water, conductive debris, humidity).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#BatteryManagementSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:label xml:lang="en">BatteryManagementSystem</rdfs:label>
    <rdfs:comment xml:lang="en">Electronic control unit managing cell balancing, thermal control, SOC/SOH estimation and fault response.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasXCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">x coordinate</rdfs:label>
    <rdfs:comment xml:lang="en">X (column) coordinate of a pixel.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#PixelCoordinate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#detectsAnomaly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">detects anomaly</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a DetectionSystem to the Anomalies it detects (inverse of detectedBy).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionSystem"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#detectedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasNominalVoltage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">nominal voltage (V)</rdfs:label>
    <rdfs:comment xml:lang="en">Nominal voltage in volts.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#BatteryComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
    <rdfs:label xml:lang="en">BatteryComponent</rdfs:label>
    <rdfs:comment xml:lang="en">A physical component of a battery system that can be monitored, affected by an anomaly, imaged, or related by parthood.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <rdfs:seeAlso rdf:resource="https://big-map.github.io/BattINFO/ontology.html"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#OvercurrentCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectricalCause"/>
    <rdfs:label xml:lang="en">OvercurrentCondition</rdfs:label>
    <rdfs:comment xml:lang="en">Sustained current above the cell rated limit, causing ohmic heating and damage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SEIFormationAnomalies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectrochemicalCause"/>
    <rdfs:label xml:lang="en">SEIFormationAnomalies</rdfs:label>
    <rdfs:comment xml:lang="en">Abnormal solid-electrolyte-interphase formation (over-thick, non-uniform, or unstable).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ProximityRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:label xml:lang="en">ProximityRelation</rdfs:label>
    <rdfs:comment xml:lang="en">Spatial relation describing proximity between cells or components (neighbours, adjacent).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#TimeInterval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleTime"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#TemporalEntity"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Interval"/>
    <rdfs:label xml:lang="en">TimeInterval</rdfs:label>
    <rdfs:comment xml:lang="en">Local class for a temporal interval with a beginning and an end (mirrors time:Interval).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#AnodeCurrentCollector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#CurrentCollector"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:label xml:lang="en">AnodeCurrentCollector</rdfs:label>
    <rdfs:comment xml:lang="en">Metallic current collector (typically copper foil) for the anode electrode.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasHeight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">height (px)</rdfs:label>
    <rdfs:comment xml:lang="en">Image height in pixels.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Image"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#VoltageSensorCompleteFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">VoltageSensorCompleteFailure</rdfs:label>
    <rdfs:comment xml:lang="en">Voltage sensor produces no valid reading.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#evidenceFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">evidence for</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an evidence item to the diagnosed anomaly occurrence that it supports.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#DiagnosticEvidence"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasEvidence"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#HighInrushCurrent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectricalCause"/>
    <rdfs:label xml:lang="en">HighInrushCurrent</rdfs:label>
    <rdfs:comment xml:lang="en">Transient high current at contactor closure stressing the cell and precharge circuit.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#DesignCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Cause"/>
    <rdfs:label xml:lang="en">DesignCause</rdfs:label>
    <rdfs:comment xml:lang="en">Root cause category: weaknesses introduced at design time (insufficient BMS protection, marginal fuse rating, poor geometry).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ThermalCycling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ThermalCause"/>
    <rdfs:label xml:lang="en">ThermalCycling</rdfs:label>
    <rdfs:comment xml:lang="en">Repeated heating/cooling cycles fatiguing mechanical and electrochemical interfaces.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasSensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has sensor</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a battery component to a sensor monitoring it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Sensor"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#sensorOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#InconsistentElectrolyteDispersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ManufacturingCause"/>
    <rdfs:label xml:lang="en">InconsistentElectrolyteDispersion</rdfs:label>
    <rdfs:comment xml:lang="en">Non-uniform electrolyte wetting producing dry zones with elevated impedance.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CoolantPumpFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">CoolantPumpFailure</rdfs:label>
    <rdfs:comment xml:lang="en">Liquid-cooling pump stopped or degraded, reducing thermal dissipation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ParticleFlakingFromCurrentCollector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ManufacturingCause"/>
    <rdfs:label xml:lang="en">ParticleFlakingFromCurrentCollector</rdfs:label>
    <rdfs:comment xml:lang="en">Flaking of active material or current-collector fragments, creating conductive debris.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SingleCellThermalRunaway">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">SingleCellThermalRunaway</rdfs:label>
    <rdfs:comment xml:lang="en">Single cell entering self-sustaining exothermic reaction.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ThermalManagementValveFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">ThermalManagementValveFault</rdfs:label>
    <rdfs:comment xml:lang="en">Coolant flow-control valve stuck or leaking.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#AuxiliaryContactFeedbackFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">AuxiliaryContactFeedbackFault</rdfs:label>
    <rdfs:comment xml:lang="en">Auxiliary contactor feedback contact providing incorrect state signal to the BMS.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#GaseousSwelling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">GaseousSwelling</rdfs:label>
    <rdfs:comment xml:lang="en">Cell case bulging due to internal gas generation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Neaf46dd55bfb4ed8913a7e89c5f7181d">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdf:rest rdf:nodeID="Ne1600f752f0d4036aa1235962c282f11"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#directCauseOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:label xml:lang="en">direct cause of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a causal phenomenon to its immediate effect; inverse of hasDirectCause.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#CausalPhenomenon"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#CausalPhenomenon"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#causeOf"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasDirectCause"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ManufacturingCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Cause"/>
    <rdfs:label xml:lang="en">ManufacturingCause</rdfs:label>
    <rdfs:comment xml:lang="en">Root cause category: defects introduced during manufacturing (assembly misalignment, coating defects, weld defects, contamination).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Observation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#DiagnosticEvidence"/>
    <rdfs:label xml:lang="en">Observation</rdfs:label>
    <rdfs:comment xml:lang="en">Local class mirroring the SOSA concept of a single act of measurement yielding one Result.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#BatteryFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:label xml:lang="en">BatteryFault</rdfs:label>
    <rdfs:comment xml:lang="en">Anomaly internal to a cell or module (short circuit, capacity fade, thermal runaway, voltage/current anomaly, degradation).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ImpedanceRise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">ImpedanceRise</rdfs:label>
    <rdfs:comment xml:lang="en">DC internal resistance above threshold indicating degradation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasGeometry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has geometry</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a spatial feature to a CRS-aware geometry.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#SpatialFeature"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Geometry"/>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#geometryOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#NailPenetration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#MechanicalCause"/>
    <rdfs:label xml:lang="en">NailPenetration</rdfs:label>
    <rdfs:comment xml:lang="en">Sharp object fully penetrating the cell, causing catastrophic internal short.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#DeepCycleOperation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#OperationalCause"/>
    <rdfs:label xml:lang="en">DeepCycleOperation</rdfs:label>
    <rdfs:comment xml:lang="en">Routine operation at full depth-of-discharge, accelerating aging.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1bde23f6decb492c86e5d56f1f39a276">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryPack"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#WeldingDefect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ManufacturingCause"/>
    <rdfs:label xml:lang="en">WeldingDefect</rdfs:label>
    <rdfs:comment xml:lang="en">Defective tab or terminal weld producing high-resistance joint or mechanical weakness.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#detectedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">detected by</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an Anomaly to the DetectionSystem that detected it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionSystem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#detectsAnomaly"/>
    <owl:propertyChainAxiom rdf:nodeID="N49a535cb357640a9821eb529e2039731"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CathodeExfoliationAging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#AgingCause"/>
    <rdfs:label xml:lang="en">CathodeExfoliationAging</rdfs:label>
    <rdfs:comment xml:lang="en">Aging-induced exfoliation (layer delamination) of cathode active material, causing capacity fade.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SpatialFeature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:label xml:lang="en">SpatialFeature</rdfs:label>
    <rdfs:comment xml:lang="en">A domain entity with a spatial extent or location, aligned with geo:Feature. Its geometry is represented separately.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#onsetOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">onset of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an onset instant to the Anomaly it marks (inverse of hasOnset).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#AnomalyOnset"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasOnset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasAnomalyInterval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has anomaly interval</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an anomaly occurrence to its active proper interval. This is the preferred name replacing the legacy hasAnomalyDuration relation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#AnomalyDuration"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasTime"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#intervalOfAnomaly"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ComponentThermalAging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#AgingCause"/>
    <rdfs:label xml:lang="en">ComponentThermalAging</rdfs:label>
    <rdfs:comment xml:lang="en">Cumulative thermal aging of non-electrochemical components (insulators, seals, interconnects).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CorrosionFromHumidity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#EnvironmentalCause"/>
    <rdfs:label xml:lang="en">CorrosionFromHumidity</rdfs:label>
    <rdfs:comment xml:lang="en">Electrochemical corrosion of terminals or tabs from humid air ingress.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Needdba7067a848cea788917c0bb4f229">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdf:rest rdf:nodeID="Nfc80147e5f2c4686b40431cf812b9455"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#isDirectPartOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:label xml:lang="en">is direct part of</rdfs:label>
    <rdfs:comment xml:lang="en">Immediate upward parthood; inverse of hasDirectPart.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#isPartOf"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasDirectPart"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#BatteryReversalPolarity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#OperationalCause"/>
    <rdfs:label xml:lang="en">BatteryReversalPolarity</rdfs:label>
    <rdfs:comment xml:lang="en">Operational fault: pack connected in reverse polarity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#BalancingCircuitFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">BalancingCircuitFailure</rdfs:label>
    <rdfs:comment xml:lang="en">General failure in the cell-balancing circuit (active or passive).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SensorTimeConstantError">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">SensorTimeConstantError</rdfs:label>
    <rdfs:comment xml:lang="en">Sensor dynamic response slower than specified.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Terminal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectricalInterface"/>
    <rdfs:label xml:lang="en">Terminal</rdfs:label>
    <rdfs:comment xml:lang="en">Electrical terminal of a cell or module: the point at which current exits or enters the cell body (positive or negative tab or post).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#triggersAnomaly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">triggers anomaly</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an observation to a diagnostic anomaly assertion that it triggered.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#triggeredByObservation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Experiment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:label xml:lang="en">Experiment</rdfs:label>
    <rdfs:comment xml:lang="en">An experimental or operational run that provides the origin for elapsed-time coordinates and groups related evidence.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasOnset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has onset</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an Anomaly to its temporal onset.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#AnomalyOnset"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasBeginning"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#onsetOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#TemporalEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleTime"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
    <rdfs:label xml:lang="en">TemporalEntity</rdfs:label>
    <rdfs:comment xml:lang="en">A temporal instant or interval aligned with OWL-Time.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb34a0b8c5da248ac92968e5f53b9da26">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryModule"/>
    <rdf:rest rdf:nodeID="N1bde23f6decb492c86e5d56f1f39a276"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#WaterImmersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#EnvironmentalCause"/>
    <rdfs:label xml:lang="en">WaterImmersion</rdfs:label>
    <rdfs:comment xml:lang="en">Bulk water immersion event causing external short circuits and chemical reactions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasRegionalPeakTemperature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">regional peak temperature (C)</rdfs:label>
    <rdfs:comment xml:lang="en">Peak temperature in degrees Celsius for a hotspot region scoped to one image or analysis result.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#HotspotRegion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#AnomalyOnset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleTime"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#TimeInstant"/>
    <rdfs:label xml:lang="en">AnomalyOnset</rdfs:label>
    <rdfs:comment xml:lang="en">Time instant at which an anomaly is first detected or estimated to begin.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasNumericValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has numeric value</rdfs:label>
    <rdfs:comment xml:lang="en">Numerical value of a structured QuantityValue result.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#QuantityValue"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/numericValue"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CathodeCurrentCollector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#CurrentCollector"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:label xml:lang="en">CathodeCurrentCollector</rdfs:label>
    <rdfs:comment xml:lang="en">Metallic current collector (typically aluminum foil) for the cathode electrode.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasDirectPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:label xml:lang="en">has direct part</rdfs:label>
    <rdfs:comment xml:lang="en">Immediate non-transitive parthood used for asserted battery assembly edges.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasPart"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#isDirectPartOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#BatteryPack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:label xml:lang="en">BatteryPack</rdfs:label>
    <rdfs:comment xml:lang="en">Complete assembled battery pack composed of multiple cells and a BMS.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasHotspot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has hotspot</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an Anomaly to one or more detected hotspot regions.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#HotspotRegion"/>
    <rdfs:subPropertyOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasLocation"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hotspotOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#TimeInstant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleTime"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#TemporalEntity"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Instant"/>
    <rdfs:label xml:lang="en">TimeInstant</rdfs:label>
    <rdfs:comment xml:lang="en">Local class for a zero-duration point in time (mirrors time:Instant).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasPixelValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">pixel value</rdfs:label>
    <rdfs:comment xml:lang="en">Intensity or temperature value at a pixel.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Pixel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#DiagnosticEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">DiagnosticEvidence</rdfs:label>
    <rdfs:comment xml:lang="en">An observation, image, record, or derived result used as evidence for a diagnostic assertion.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#positionsHotspot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">positions hotspot</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a pixel-coordinate individual to the hotspot region that it positions.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#PixelCoordinate"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#HotspotRegion"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasSpatialPosition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasSampleCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">sample count</rdfs:label>
    <rdfs:comment xml:lang="en">Number of samples in an observation series.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#AnomalyDuration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleTime"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#TimeInterval"/>
    <rdfs:label xml:lang="en">AnomalyDuration</rdfs:label>
    <rdfs:comment xml:lang="en">Time interval during which an anomaly is active.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#PixelCoordinate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleImaging"/>
    <rdfs:label xml:lang="en">PixelCoordinate</rdfs:label>
    <rdfs:comment xml:lang="en">Integer (x, y) coordinate pair identifying a Pixel location within an Image.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#detectedAnomaly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">detected anomaly</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a detection event to the anomaly assertions it produced.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#DetectionEvent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#wasDetectedIn"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasChemistry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has chemistry</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a cell or pack to its active-material chemistry.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryChemistry"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#chemistryOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Sensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleSOSA"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:label xml:lang="en">Sensor</rdfs:label>
    <rdfs:comment xml:lang="en">Local class for sensing devices; superclass of Voltage/Current/TemperatureSensor.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ExtremeHotOperation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ThermalCause"/>
    <rdfs:label xml:lang="en">ExtremeHotOperation</rdfs:label>
    <rdfs:comment xml:lang="en">Operation above the cell qualified high-temperature limit.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#chemistryOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">chemistry of</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a chemistry to the cells or packs using it (inverse of hasChemistry).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryChemistry"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasChemistry"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasDurationSeconds">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">duration (s)</rdfs:label>
    <rdfs:comment xml:lang="en">Duration in seconds.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#AnomalyDuration"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb71ad3367c2543798dfa9e564789600b">
    <rdf:first rdf:resource="http://www.battery-ontology.org/liBatteryFault#SpatialFeature"/>
