  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ThermoelectricElementDegradation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">ThermoelectricElementDegradation</rdfs:label>
    <rdfs:comment xml:lang="en">Thermoelectric (Peltier) element degraded, losing cooling capacity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#VoltageSensorDrift">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">VoltageSensorDrift</rdfs:label>
    <rdfs:comment xml:lang="en">Voltage channel slow drift over time.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#UnderchargeFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryFault"/>
    <rdfs:label xml:lang="en">UnderchargeFault</rdfs:label>
    <rdfs:comment xml:lang="en">Cell voltage below safe lower limit (undercharge or deep-discharge).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
