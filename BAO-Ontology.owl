    <rdfs:label xml:lang="en">PreChargeTimeout</rdfs:label>
    <rdfs:comment xml:lang="en">Precharge sequence does not complete within the expected time window.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasLocation">
