    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#SpatialFeature"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#atLocation"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#locationOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#OperationalCause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Cause"/>
    <rdfs:label xml:lang="en">OperationalCause</rdfs:label>
    <rdfs:comment xml:lang="en">Root cause category: usage-pattern stressors (deep discharge, repeated abuse cycles, reverse polarity, overcurrent stress).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ThermalPropagationPath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleGeo"/>
    <rdfs:label xml:lang="en">ThermalPropagationPath</rdfs:label>
    <rdfs:comment xml:lang="en">Spatial path representing the trajectory of thermal runaway propagation between cells.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#AnomalyData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#DiagnosticEvidence"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">AnomalyData</rdfs:label>
    <rdfs:comment xml:lang="en">Raw or derived data record describing an anomaly occurrence for provenance tracking.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#DustInfiltration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#EnvironmentalCause"/>
    <rdfs:label xml:lang="en">DustInfiltration</rdfs:label>
    <rdfs:comment xml:lang="en">Non-conductive dust reducing cooling efficiency and accelerating hotspot formation.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasLatitude">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">latitude</rdfs:label>
    <rdfs:comment xml:lang="en">WGS84 latitude coordinate in degrees.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#Point"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasImage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has image</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a component to an image captured of it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#BatteryComponent"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#Image"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#imageOf"/>
  </rdf:Description>
