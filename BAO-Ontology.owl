    <owl:members rdf:nodeID="N137320c03cc440d3a83860a735d75656"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#unitOfQuantityValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <rdfs:label xml:lang="en">unit of quantity value</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a measurement unit to quantity values expressed in it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.battery-ontology.org/liBatteryFault#MeasurementUnit"/>
    <rdfs:range rdf:resource="http://www.battery-ontology.org/liBatteryFault#QuantityValue"/>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
    <owl:inverseOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#hasMeasurementUnit"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#CANBusFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">CANBusFailure</rdfs:label>
    <rdfs:comment xml:lang="en">CAN bus communication failure affecting control of BMS actuators or peripherals.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#SelfHeatingDuringOperation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ThermalCause"/>
    <rdfs:label xml:lang="en">SelfHeatingDuringOperation</rdfs:label>
    <rdfs:comment xml:lang="en">Ohmic and reaction heat accumulation exceeding thermal dissipation capacity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ThermalShock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ThermalCause"/>
    <rdfs:label xml:lang="en">ThermalShock</rdfs:label>
    <rdfs:comment xml:lang="en">Abrupt temperature change inducing differential expansion and cracking.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#Connector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleBattINFO"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ElectricalInterface"/>
    <rdfs:label xml:lang="en">Connector</rdfs:label>
    <rdfs:comment xml:lang="en">Mechanical and electrical connector joining modules, harness, or external load/charger interface.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ActuatorFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#Anomaly"/>
    <rdfs:label xml:lang="en">ActuatorFault</rdfs:label>
    <rdfs:comment xml:lang="en">Anomaly arising from a failure of a control actuator (contactor, relay, fuse, heater, pump, balancing MOSFET) in the battery system.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#ChargerVoltageCurrentRegulationFault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">ChargerVoltageCurrentRegulationFault</rdfs:label>
    <rdfs:comment xml:lang="en">Charger unable to hold the commanded voltage or current setpoint.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#PreChargeResistorOpenCircuit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ActuatorFault"/>
    <rdfs:label xml:lang="en">PreChargeResistorOpenCircuit</rdfs:label>
    <rdfs:comment xml:lang="en">Precharge resistor open, preventing bus precharge.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#TemperatureSensorBias">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#SensorFault"/>
    <rdfs:label xml:lang="en">TemperatureSensorBias</rdfs:label>
    <rdfs:comment xml:lang="en">Constant offset on the temperature channel.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#DiagnosticEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.battery-ontology.org/liBatteryFault#ModuleProv"/>
    <rdfs:label xml:lang="en">DiagnosticEntity</rdfs:label>
    <rdfs:comment xml:lang="en">A provenance-bearing diagnostic system, algorithm, configuration, report, or related entity.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
