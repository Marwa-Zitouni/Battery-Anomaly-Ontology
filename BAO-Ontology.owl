    <rdfs:label xml:lang="en">OvervoltageCondition</rdfs:label>
    <rdfs:comment xml:lang="en">Voltage above safe operating window, causing accelerated degradation or venting.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#MetallicParticleContamination">
