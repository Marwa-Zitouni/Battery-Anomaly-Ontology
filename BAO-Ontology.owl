    <rdfs:label xml:lang="en">CurrentSensorCompleteFailure</rdfs:label>
    <rdfs:comment xml:lang="en">Current sensor produces no valid reading.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://www.battery-ontology.org/liBatteryFault"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.battery-ontology.org/liBatteryFault#hasDescription">
